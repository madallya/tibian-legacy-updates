Cyclopedia74Help < UIWidget
  size: 14 12
  image-source: /game_cyclopedia74/images/icon-help

// ---- janela -----------------------------------------------------------------
MainWindow
  id: cyclopedia74Window
  !text: tr('Cyclopedia')
  size: 678 548
  visible: false
  @onEscape: modules.game_cyclopedia74.hide()

  // abas
  UIWidget
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    height: 36

    Cyclopedia74Tab
      id: bestiaryTab
      anchors.left: parent.left
      margin-left: 0
      width: 101
      !text: tr('Bestiary (tab)')
      @onClick: modules.game_cyclopedia74.showTab('bestiary')

    Cyclopedia74Tab
      id: charmTab
      width: 101
      !text: tr('Charm')
      @onClick: modules.game_cyclopedia74.showTab('charm')

    Cyclopedia74Tab
      id: achievementsTab
      width: 140
      !text: tr('Achievements')
      @onClick: modules.game_cyclopedia74.showTab('achievements')

    // resto da barra à direita das abas: textura mais escura (~79%), como no Miracle
    UIWidget
      id: tabBarRest
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: achievementsTab.right
      anchors.right: parent.right
      background-color: #00000035
      phantom: true

  // ---- Bestiary: grade ----------------------------------------------------
  UIWidget
    id: bestiaryPanel
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomSeparator.top
    margin-top: 5

    // linha de baixo medida no print do Miracle: Search 64x23, campo 150x23 afundado,
    // botões de página 16x18 e 18x18 com setas cheias
    Button
      id: searchButton
      size: 64 23
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-bottom: 5
      !text: tr('Search')
      @onClick: modules.game_cyclopedia74.doSearch()

    TextEdit
      id: searchEdit
      size: 150 23
      anchors.right: searchButton.left
      anchors.verticalCenter: searchButton.verticalCenter
      margin-right: 7
      image-source: /game_cyclopedia74/images/search-box
      image-border: 1
      padding: 3 4 3 4
      placeholder: Type to search
      placeholder-color: #6E706F
      color: #C0C0C0
      text-align: left
      @onEnter: modules.game_cyclopedia74.doSearch()

    Label
      id: pageLabel
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: searchButton.verticalCenter
      size: 50 20
      text-align: center
      !text: '1 / 1'
      color: #DFDFDF

    Button
      id: nextButton
      size: 18 18
      anchors.left: pageLabel.right
      anchors.verticalCenter: searchButton.verticalCenter
      margin-left: 7
      icon-source: /game_cyclopedia74/images/page-next
      @onClick: modules.game_cyclopedia74.changePage(1)
      $disabled:
        icon-source: /game_cyclopedia74/images/page-next-disabled

    Button
      id: prevButton
      size: 18 18
      anchors.right: pageLabel.left
      anchors.verticalCenter: searchButton.verticalCenter
      margin-right: 7
      icon-source: /game_cyclopedia74/images/page-prev
      @onClick: modules.game_cyclopedia74.changePage(-1)
      $disabled:
        icon-source: /game_cyclopedia74/images/page-prev-disabled

    Button
      id: firstButton
      size: 16 18
      anchors.right: prevButton.left
      anchors.verticalCenter: searchButton.verticalCenter
      margin-right: 5
      icon-source: /game_cyclopedia74/images/page-first
      @onClick: modules.game_cyclopedia74.changePage('first')
      $disabled:
        icon-source: /game_cyclopedia74/images/page-first-disabled

    // a grade fica numa moldura afundada de 1 px (Miracle); cartões 122 a cada 128 px
    Panel
      id: listBase
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: searchButton.top
      margin-bottom: 7
      image-source: /game_cyclopedia74/images/grid-frame
      image-border: 1

      UIWidget
        id: grid
        anchors.fill: parent
        padding-left: 6
        padding-top: 6
        layout:
          type: grid
          cell-size: 122 122
          cell-spacing: 6
          num-columns: 5
          flow: true

      Label
        id: loadingLabel
        anchors.centerIn: parent
        color: #9d9d9d
        text-auto-resize: true
        phantom: true

      // ---- Bestiary: ficha da criatura -------------------------------------
      UIWidget
        id: creatureInfo
        anchors.fill: parent
        image-source: /images/ui/outfits/minipanel
        image-border: 20
        visible: false
        !text: tr('Creature Name')
        text-align: top
        text-offset: 0 4
        color: #919191

        UIWidget
          id: leftBase
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.verticalCenter
          margin-top: 20
          margin-left: 5
          width: 125
          phantom: true
          // elite creatures: "Stage: Normal / 1 Star / 2 Stars / 3 Stars", como no Miracle
          ComboBox
            id: stageCombo
            anchors.bottom: parent.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-left: 2
            margin-right: 2
            height: 20
            // 11/11: texto centralizado no campo, fora da seta (o padrão do ComboBox puxa
            // -15 px, feito para 91 px de largura: aqui o texto encostava na borda)
            text-offset: -10 1
          CheckBox
            id: trackCheck
            anchors.bottom: stageCombo.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 6
            !text: tr('Track Kills')
            text-auto-resize: true
            color: #C7C7C7
            @onCheckChange: modules.game_cyclopedia74.onTrackChange(self:isChecked())
          UICreature
            id: sprite
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 30
            size: 96 96
            border-width: 0
            padding: 0
          // estrelas da elite, no canto de cima à direita do boneco
          // estrelas da elite (as do Miracle), na mesma posição das prints
          UIWidget
            id: eliteStars
            anchors.top: sprite.top
            anchors.left: sprite.left
            margin-top: 8
            margin-left: 77
            size: 9 10
            image-source: /game_elite74/images/stars_card1
            visible: false
            phantom: true

        // Total Kills: 3 barras (60x25, moldura afundada de 1 px, 1 px entre elas)
        Cyclopedia74Sunken
          id: progressBorder2
          anchors.left: leftBase.right
          anchors.top: parent.top
          margin-top: 36
          margin-left: 79
          size: 60 25
          background-color: #363636
        Cyclopedia74Sunken
          id: progressBorder1
          anchors.right: progressBorder2.left
          anchors.top: progressBorder2.top
          margin-right: 1
          size: 60 25
          background-color: #363636
        Cyclopedia74Sunken
          id: progressBorder3
          anchors.left: progressBorder2.right
          anchors.top: progressBorder2.top
          margin-left: 1
          size: 60 25
          background-color: #363636
        UIWidget
          id: progressBack1
          anchors.left: progressBorder1.left
          anchors.top: progressBorder1.top
          margin-left: 1
          margin-top: 1
          height: 23
          phantom: true
        UIWidget
          id: progressBack2
          anchors.left: progressBorder2.left
          anchors.top: progressBorder2.top
          margin-left: 1
          margin-top: 1
          height: 23
          phantom: true
        UIWidget
          id: progressBack3
          anchors.left: progressBorder3.left
          anchors.top: progressBorder3.top
          margin-left: 1
          margin-top: 1
          height: 23
          phantom: true
        Label
          id: progressValue
          anchors.centerIn: progressBorder2
          text-auto-resize: true
          !text: '0'
          phantom: true
        Label
          id: totalLabel
          anchors.bottom: progressBorder2.top
          anchors.left: progressBorder1.right
          margin-bottom: 2
          !text: tr('Total Kills')
          color: #C7C7C7

        // dificuldade (5 caveiras) e ocorrência (4 diamantes)
        UIWidget
          id: starBase
          anchors.left: progressBorder1.left
          anchors.top: progressBorder2.bottom
          margin-top: 4
          image-source: /game_cyclopedia74/images/bestiary/difficulty_disabled
          image-repeated: true
          size: 50 9
        UIWidget
          id: starFill
          anchors.left: progressBorder1.left
          anchors.top: starBase.top
          image-source: /game_cyclopedia74/images/bestiary/difficulty
          image-repeated: true
          size: 0 9
        UIWidget
          id: diamondBase
          anchors.left: progressBorder1.left
          anchors.top: starFill.bottom
          margin-top: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-diamond-inactive
          image-repeated: true
          size: 36 10
        UIWidget
          id: diamondFill
          anchors.left: progressBorder1.left
          anchors.top: diamondBase.top
          image-source: /game_cyclopedia74/images/icons/monster-icon-diamond-active
          image-repeated: true
          size: 0 10
        // invocar / convencer
        UIWidget
          id: summonIcon
          anchors.top: diamondBase.bottom
          anchors.left: diamondBase.left
          margin-top: 5
          size: 18 9
          image-source: /images/icons/icons-skills
          image-clip: 18 0 18 9
        UIWidget
          id: convinceIcon
          anchors.top: summonIcon.top
          anchors.left: summonIcon.right
          margin-left: 2
          size: 18 9
          image-source: /images/icons/icons-skills
          image-clip: 36 0 18 9
        UIWidget
          id: bonusIcon
          anchors.top: summonIcon.bottom
          anchors.left: summonIcon.left
          margin-top: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-bonuspoints
        Label
          id: bonusValue
          anchors.verticalCenter: bonusIcon.verticalCenter
          anchors.left: bonusIcon.right
          margin-left: 5
          text-auto-resize: true
          !text: '?'
          color: #C7C7C7

        // Charm Selection
        UIWidget
          id: charmBase
          anchors.bottom: leftBase.bottom
          anchors.left: bonusIcon.left
          image-source: /images/ui/panel_flat
          image-border: 10
          size: 45 45
          UIWidget
            id: charmIcon
            anchors.centerIn: parent
            size: 22 22
            phantom: true
        Button
          id: selectButton
          size: 70 20
          anchors.left: charmBase.right
          anchors.bottom: charmBase.bottom
          margin-left: 5
          !text: tr('Select')
          text-offset: 0 -1
          color: #C0C0C0
          @onClick: modules.game_cyclopedia74.selectCharmForRace()
        ComboBox
          id: charmSelector
          anchors.left: selectButton.left
          anchors.right: progressBorder3.right
          anchors.top: charmBase.top
          text-align: center
          @onOptionChange: modules.game_cyclopedia74.onCharmOptionChange()
        UIWidget
          id: balanceBase
          anchors.right: charmSelector.right
          anchors.left: selectButton.right
          anchors.bottom: selectButton.bottom
          height: 20
          margin-left: 5
          image-source: /game_cyclopedia74/images/charm-item
          image-border: 10
          UIWidget
            id: goldIcon
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 5
            image-source: /game_cyclopedia74/images/icon_gold
          Label
            id: goldBalance
            anchors.right: goldIcon.left
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 5
            text-align: right
            !text: '?'
        Label
          id: charmLabel
          anchors.bottom: charmBase.top
          anchors.left: charmBase.left
          margin-bottom: 3
          text-auto-resize: true
          !text: tr('Charm Selection:')
          color: #C7C7C7

        // vida / exp / velocidade / armadura
        UIWidget
          id: iconsSep
          anchors.left: progressBorder2.left
          anchors.top: progressBorder2.bottom
          anchors.bottom: charmLabel.top
          margin-left: 24
          margin-top: 4
          margin-bottom: 4
          width: 1
          background-color: #6a6a6a
        UIWidget
          id: icon1
          anchors.top: iconsSep.top
          anchors.left: iconsSep.right
          margin-top: 2
          margin-left: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-hitpoints
        Label
          id: value1
          anchors.verticalCenter: icon1.verticalCenter
          anchors.left: icon1.right
          margin-left: 5
          margin-bottom: 1
          text-auto-resize: true
          !text: '?'
          color: #C7C7C7
        UIWidget
          id: icon2
          anchors.top: icon1.bottom
          anchors.left: iconsSep.right
          margin-top: 7
          margin-left: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-experience
        Label
          id: value2
          anchors.verticalCenter: icon2.verticalCenter
          anchors.left: icon2.right
          margin-left: 5
          margin-bottom: 1
          text-auto-resize: true
          !text: '?'
          color: #C7C7C7
        UIWidget
          id: icon3
          anchors.top: icon2.bottom
          anchors.left: iconsSep.right
          margin-top: 7
          margin-left: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-speed
        Label
          id: value3
          anchors.verticalCenter: icon3.verticalCenter
          anchors.left: icon3.right
          margin-left: 5
          margin-bottom: 1
          text-auto-resize: true
          !text: '?'
          color: #C7C7C7
        UIWidget
          id: icon4
          anchors.top: icon3.bottom
          anchors.left: iconsSep.right
          margin-top: 7
          margin-left: 5
          image-source: /game_cyclopedia74/images/icons/monster-icon-armor
        Label
          id: value4
          anchors.verticalCenter: icon4.verticalCenter
          anchors.left: icon4.right
          margin-left: 5
          margin-bottom: 1
          text-auto-resize: true
          !text: '?'
          color: #C7C7C7

        // resistências (2 linhas de 4)
        UIWidget
          id: physicalResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-physical-resist
          anchors.left: progressBorder3.right
          anchors.top: parent.top
          margin-top: 35
          margin-left: 10
        Cyclopedia74Resist
          id: physicalProgress
          anchors.left: physicalResist.right
          anchors.bottom: physicalResist.bottom
          margin-left: 5
        Cyclopedia74ResistIcon
          id: earthResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-earth-resist
        Cyclopedia74Resist
          id: earthProgress
          anchors.left: earthResist.right
          anchors.bottom: earthResist.bottom
          margin-left: 5
        Cyclopedia74ResistIcon
          id: fireResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-fire-resist
        Cyclopedia74Resist
          id: fireProgress
          anchors.left: fireResist.right
          anchors.bottom: fireResist.bottom
          margin-left: 5
        Cyclopedia74ResistIcon
          id: deathResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-death-resist
        Cyclopedia74Resist
          id: deathProgress
          anchors.left: deathResist.right
          anchors.bottom: deathResist.bottom
          margin-left: 5
        UIWidget
          id: energyResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-energy-resist
          anchors.left: progressBorder3.right
          anchors.top: physicalResist.bottom
          margin-top: 10
          margin-left: 10
        Cyclopedia74Resist
          id: energyProgress
          anchors.left: energyResist.right
          anchors.bottom: energyResist.bottom
          margin-left: 5
        Cyclopedia74ResistIcon
          id: holyResist
          image-source: /game_cyclopedia74/images/icons/monster-icon-holy-resist
        Cyclopedia74Resist
          id: holyProgress
          anchors.left: holyResist.right
          anchors.bottom: holyResist.bottom
          margin-left: 5
        Cyclopedia74ResistIcon
