Cyclopedia74ResistIcon < UIWidget
  size: 9 9
  anchors.top: prev.top
  anchors.left: prev.right
  margin-left: 5

// item do loot
// casa do loot: 32x32, moldura de 1 px em relevo e fundo transparente (Miracle)
Cyclopedia74Item < UIItem
  size: 32 32
  border-width: 1
  border-color-top: #6d6d6d
  border-color-left: #6d6d6d
  border-color-bottom: #282828
  border-color-right: #282828
  anchors.verticalCenter: parent.verticalCenter
