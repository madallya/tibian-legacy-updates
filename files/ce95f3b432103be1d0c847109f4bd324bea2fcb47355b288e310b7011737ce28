// Cyclopedia no estilo do cliente do Miracle (que é o módulo game_cyclopedia do
// OTClient com outra pele): abas Bestiary, Charm e Achievements; grade de
// criaturas 5 x 3; ficha com Total Kills em 3 barras, dificuldade, ocorrência,
// resistências, Charm Selection, Location(s) e loot por raridade; rodapé com
// ouro, pontos de charm e de achievements, "Bestiary Tracker" e "Close".

// ---- peças ---------------------------------------------------------------------
// aba: moldura de 1 px em relevo (claro em cima/esquerda, escuro embaixo/direita);
// a ativa fica afundada (e 1 px mais baixa em cima). Cores medidas nas prints do
// Miracle. 11/11: por dentro a textura da janela escurecida (~85%), como no Miracle
Cyclopedia74Tab < UIButton
  height: 36
  anchors.top: parent.top
  anchors.left: prev.right
  margin-left: -1
  text-align: left
  text-offset: 43 0
  font: verdana-11px-monochrome
  color: #dfdfdf
  background-color: #00000026
  border-width: 1
  border-color-top: #6c6c6c
  border-color-left: #626262
  border-color-bottom: #262626
  border-color-right: #232323
  $checked:
    text-offset: 43 0
    margin-top: 1
    height: 35
    border-color-top: #262626
    border-color-left: #232323
    border-color-bottom: #656565
    border-color-right: #666666

  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    size: 34 34
    phantom: true

// moldura de 1 px afundada (barras de Total Kills, painel do loot)
Cyclopedia74Sunken < UIWidget
  border-width: 1
  border-color-top: #6d6d6d
  border-color-left: #373737
  border-color-bottom: #6d6d6d
  border-color-right: #6f6f6f

Cyclopedia74ProgressBackground < UIWidget
  image-source: /images/ui/1pixel_down_frame
  image-border: 5
  padding: 1
  UIWidget
    image-source: /images/ui/backdrop-dark-grey
    image-border: 5
    anchors.fill: parent
    phantom: true

// cartão de criatura (grade 5 x 3)
Cyclopedia74Creature < UIWidget
  image-source: /images/ui/outfits/minipanel
  image-border: 20
  Label
    id: Name
    height: 20
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 2
    margin-right: 2
    text-align: center
    text-offset: 0 0
    color: #919191
  UIWidget
    id: ClassBase
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 24
    size: 68 68
    image-source: /images/ui/2pixel_up_frame_borderimage
    image-border: 10
    $pressed:
      image-source: /images/ui/2pixel_up_frame_borderimage_dark_reversed
  UICreature
    id: Sprite
    anchors.fill: ClassBase
    phantom: true
  Label
    id: KillsLabel
    anchors.horizontalCenter: ClassBase.horizontalCenter
    anchors.top: ClassBase.bottom
    margin-top: 1
    !text: tr('?')
    text-auto-resize: true
    color: #C1C1C1
  UIWidget
    id: Finalized
    image-source: /game_cyclopedia74/images/checkmark-icon
    anchors.horizontalCenter: ClassBase.horizontalCenter
    anchors.top: ClassBase.bottom
    margin-top: 1
    visible: false

// barra de resistência
Cyclopedia74Resist < UIWidget
  image-source: /game_cyclopedia74/images/bestiary/barra
  size: 55 7
  UIWidget
    id: Fill
    anchors.fill: parent
    background-color: white
    margin-left: 1
    margin-bottom: 2
    margin-top: 2
    margin-right: 1
    phantom: true
  UIWidget
    id: Border
    anchors.fill: parent
    image-source: /game_cyclopedia74/images/bestiary/barra
