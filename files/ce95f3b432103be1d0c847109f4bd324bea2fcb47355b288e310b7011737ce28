    visible: false
  Label
    id: Stackable
    text-auto-resize: true
    font: verdana-11px-rounded
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    color: #BFBFBF
    margin-bottom: -1

Cyclopedia74ItemGroup < UIWidget
  height: 45
  UIWidget
    id: Items
    anchors.fill: parent
    margin-left: 108
  Label
    id: Title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
