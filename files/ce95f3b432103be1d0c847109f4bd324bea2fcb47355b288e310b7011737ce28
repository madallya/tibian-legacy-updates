    background-color: #585858

Cyclopedia74CharmStar < UIWidget
  size: 9 10
  anchors.top: parent.top
  anchors.left: prev.right
  margin-left: 5
  image-source: /game_cyclopedia74/images/star-inactive
  phantom: true
