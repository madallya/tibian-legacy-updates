-- Quest Log e Quest Tracker (OTServ 7.4 / Tibian Legacy), no estilo do Miracle.
-- O servidor monta a lista a partir dos QuestValues do personagem e do arquivo
-- quests.txt (ver src/game/questlog.hh): o cliente pede com o comando 0xE4 e
-- recebe a resposta no mesmo código. Pedido v2: manda os nomes das quests que
-- vai mostrar (a aberta em "Show" e as do Quest Tracker) e o servidor manda as
-- missões só delas; as outras vêm só com nome e "completed". Assim um
-- personagem com todas as quests não estoura o pacote. Servidor antigo responde
-- na v1 (todas as missões) e o cliente entende as duas.

local OPCODE = 0xE4
-- passo feito: check verde (como no Miracle); a fazer: quadradinho vazio
local CHECK_DONE = '/game_questlog74/images/check_done'
local CHECK_TODO = '/game_questlog74/images/check_todo'

local window
local tracker
local quests = {}       -- última lista recebida
local details = {}      -- missões por nome de quest (últimas recebidas)
local showing = nil     -- nome da quest aberta em "Show"
local tracked = {}      -- nomes acompanhados no Quest Tracker
local refreshEvent

-- Quest Tracker: quests acompanhadas guardadas por personagem ---------------------
local function trackerKey()
    return 'classic74_questTracker_' .. (g_game.getCharacterName() or '')
end

local function loadTracked()
    tracked = {}
    local text = g_settings.getString(trackerKey()) or ''
    for name in text:gmatch('[^\n]+') do table.insert(tracked, name) end
end

local function saveTracked()
    g_settings.set(trackerKey(), table.concat(tracked, '\n'))
end

local function isTracked(name)
    for _, n in ipairs(tracked) do if n == name then return true end end
    return false
end

local function findQuest(name)
    for _, q in ipairs(quests) do if q.name == name then return q end end
end

-- Pedido e resposta -----------------------------------------------------------------
function request()
    local protocol = g_game.getProtocolGame()
    if not protocol or not g_game.isOnline() then return end
    if modules.game_livecam74 and modules.game_livecam74.isSpectating and modules.game_livecam74.isSpectating() then
        return
    end
    local names, seen = {}, {}
    local function want(name)
        if name and not seen[name] and #names < 32 then
            seen[name] = true
            table.insert(names, name)
        end
    end
    want(showing)
    for _, name in ipairs(tracked) do want(name) end
    local msg = OutputMessage.create()
    msg:addU8(OPCODE)
    msg:addU8(2)
    msg:addU8(#names)
    for _, name in ipairs(names) do msg:addString(name) end
    protocol:send(msg)
end

local refreshAll

local function readMissions(msg)
    local missions = {}
    for j = 1, msg:getU8() do
        local m = { name = msg:getString() }
        local state = msg:getU8()
        m.done = state == 1
        m.prologue = state == 2 -- texto de abertura da quest (sem check)
        m.text = msg:getString()
        missions[j] = m
    end
    return missions
end

local function onQuestLog(protocol, msg)
    local list = {}
    local count = msg:getU16()
    local v2 = count == 0xFFFF
    if v2 then
        msg:getU8() -- versão (2)
        count = msg:getU16()
    else
        details = {}
    end
    for i = 1, count do
        local q = { name = msg:getString(), completed = msg:getU8() == 1 }
        if not v2 or msg:getU8() == 1 then
            details[q.name] = readMissions(msg)
        end
        q.missions = details[q.name] or {}
        list[i] = q
    end
    setQuests(list)
end

-- mostra uma lista já lida (também usado para testar a janela sem servidor)
function setQuests(list)
    quests = list or {}
    refreshAll()
end

-- Quest Log ---------------------------------------------------------------------------
-- quest da caixa "Track Quest": a aberta ("Show") ou a selecionada na lista
local function currentQuestName()
    if not window then return nil end
    if showing then return showing end
    local selected = window:getChildById('questList'):getFocusedChild()
    return selected and selected.questName
end

local updatingTrackBox = false
local function updateTrackBox()
    if not window then return end
    local box = window:getChildById('trackCheck')
    local name = currentQuestName()
    updatingTrackBox = true
    box:setEnabled(name ~= nil)
    box:setChecked(name ~= nil and isTracked(name))
    updatingTrackBox = false
end

function onTrackCheck(checked)
    if updatingTrackBox then return end
    local name = currentQuestName()
    if not name then return end
    if checked then
        if not isTracked(name) then
            table.insert(tracked, name)
            saveTracked()
        end
        openTracker()
    else
        untrack(name)
    end
end

local function setShowMode(on)
    if not window then return end
    for _, id in ipairs({ 'questList', 'questScroll' }) do window:getChildById(id):setVisible(not on) end
    for _, id in ipairs({ 'missionList', 'missionScroll', 'missionText' }) do window:getChildById(id):setVisible(on) end
    window:getChildById('emptyLabel'):setVisible(not on and #quests == 0)
    window:getChildById('showButton'):setText(on and tr('Back') or tr('Show'))
    window:setText(on and showing or tr('Quest Log'))
    updateTrackBox()
end

local function fillMissions()
    local list = window:getChildById('missionList')
    local text = window:getChildById('missionText')
    list:destroyChildren()
    text:setText('')
    local quest = showing and findQuest(showing)
    if not quest then
        showing = nil
        setShowMode(false)
        return
    end
    window:setText(quest.name)
    for _, m in ipairs(quest.missions) do
        local row = g_ui.createWidget('QuestLine74Row', list)
        local name = row:getChildById('name')
        name:setText(m.name)
        if m.prologue then
            -- prólogo: só descrição, sem check, centralizado e em destaque
            row:getChildById('check'):setVisible(false)
            name:breakAnchors()
            name:addAnchor(AnchorLeft, 'parent', AnchorLeft)
            name:addAnchor(AnchorRight, 'parent', AnchorRight)
            name:addAnchor(AnchorVerticalCenter, 'parent', AnchorVerticalCenter)
            name:setMarginLeft(0)
            name:setTextAlign(AlignCenter)
            name:setColor('#d9b45a')
        else
            row:getChildById('check'):setImageSource(m.done and CHECK_DONE or CHECK_TODO)
            name:setColor(m.done and '#dfdfdf' or '#9d9d9d')
        end
        row.mission = m
    end
    list.onChildFocusChange = function(_, child)
        if child and child.mission then
            local m = child.mission
            -- missão em andamento: o servidor manda o texto da etapa atual
            text:setText(m.text ~= '' and m.text or tr('Not done yet.'))
        end
    end
    local first = list:getFirstChild()
    if first then list:focusChild(first) end
end

local function fillQuests()
    local list = window:getChildById('questList')
    local selected = list:getFocusedChild()
    local selectedName = selected and selected.questName
    list:destroyChildren()
    for _, q in ipairs(quests) do
        local row = g_ui.createWidget('QuestLog74Row', list)
        row:setText(q.completed and (q.name .. ' ' .. tr('(completed)')) or q.name)
        row.questName = q.name
        row.onDoubleClick = function() showQuest(q.name) end
        if q.name == selectedName then list:focusChild(row) end
    end
    list.onChildFocusChange = function() updateTrackBox() end
    if not list:getFocusedChild() and list:getFirstChild() then list:focusChild(list:getFirstChild()) end
    updateTrackBox()
    window:getChildById('emptyLabel'):setText(tr('You have not started any quest yet.'))
    window:getChildById('emptyLabel'):setVisible(#quests == 0 and not showing)
end

function showQuest(name)
    showing = name
    setShowMode(true)
    fillMissions()
    request() -- missões da quest aberta
end

function toggleShow()
    if not window then return end
    if showing then
        showing = nil
        setShowMode(false)
        return
    end
    local selected = window:getChildById('questList'):getFocusedChild()
    if selected and selected.questName then showQuest(selected.questName) end
end

function show()
    if not window then return end
    showing = nil
    setShowMode(false)
    fillQuests()
    window:show()
    window:raise()
    window:focus()
    request()
end

function hide()
    if window then window:hide() end
end

function toggle()
    if window and window:isVisible() then hide() else show() end
end

-- Quest Tracker -------------------------------------------------------------------------
local adjustTrackerMinimum
local function fillTracker()
    if not tracker then return end
    local contents = tracker:getChildById('contentsPanel')
    contents:destroyChildren()
    local any = false
    for _, name in ipairs(tracked) do
        local q = findQuest(name)
        -- clique direito em qualquer linha da quest (título, missão ou texto)
        local function stopMenu(widget, pos, button)
            if button == MouseRightButton then
                local menu = g_ui.createWidget('PopupMenu')
                menu:addOption(tr('Stop tracking'), function() untrack(name) end)
                menu:display(pos)
                return true
            end
        end
        if any then
            g_ui.createWidget('QuestTracker74Separator', contents)
        end
        local title = g_ui.createWidget('QuestTracker74Title', contents)
        title:setText((q and q.completed) and (name .. ' ' .. tr('(completed)')) or name)
        title.onMouseRelease = stopMenu
        any = true
        -- só o que falta fazer (a etapa atual); as missões concluídas ficam
        -- só no Quest Log
        for _, m in ipairs(q and q.missions or {}) do
            if not m.done and not m.prologue then
                local row = g_ui.createWidget('QuestTracker74Mission', contents)
                row:getChildById('check'):setImageSource(CHECK_TODO)
                row:getChildById('name'):setText(m.name)
                row:getChildById('name'):setColor('#ffffff')
                row.onMouseRelease = stopMenu
                if m.text ~= '' then
                    local text = g_ui.createWidget('QuestTracker74Text', contents)
                    text:setText(m.text)
                    text.onMouseRelease = stopMenu
                end
            end
        end
    end
    if not any then
        local label = g_ui.createWidget('QuestTracker74Text', contents)
        label:setText(tr('Select a quest in the Quest Log and press "Quest Tracker".'))
    end
    -- a altura dos textos (quebra de linha) so sai depois do layout
    scheduleEvent(adjustTrackerMinimum, 50)
end

-- ots74: o minimo da janela e o que mostra todo o conteudo do tracker (textos
-- inteiros). Com muitas quests acompanhadas o minimo para em TRACKER_MAX_MIN
-- e o resto rola.
local TRACKER_HEADER = 16
local TRACKER_MAX_MIN = 300
adjustTrackerMinimum = function()
    if not tracker then return end
    local contents = tracker:getChildById('contentsPanel')
    local h = contents:getPaddingTop() + contents:getPaddingBottom()
    for _, child in ipairs(contents:getChildren()) do
        h = h + child:getHeight() + child:getMarginTop() + child:getMarginBottom()
    end
    h = math.min(TRACKER_HEADER + h, TRACKER_MAX_MIN)
    tracker:setContentMinimumHeight(h)
    if tracker:isVisible() and not tracker:isOn() and tracker:getHeight() < tracker:getMinimumHeight() then
        tracker:setHeight(tracker:getMinimumHeight())
    end
end

refreshAll = function()
    if window and window:isVisible() then
        if showing then fillMissions() else fillQuests() end
    end
    fillTracker()
end

function untrack(name)
    for i, n in ipairs(tracked) do
        if n == name then table.remove(tracked, i); break end
    end
    saveTracked()
    fillTracker()
    updateTrackBox()
end

function openTracker()
    if not tracker then return end
    if not tracker:isVisible() or not tracker:getParent() then
        if not tracker:getParent() then
            local panel = modules.game_interface.findContentPanelAvailable(tracker, tracker:getMinimumHeight())
            if not panel then return end
            panel:addChild(tracker)
        end
        tracker:open()
    end
    fillTracker()
    request()
end

function toggleTracker()
    if not tracker then return end
    if tracker:isVisible() and tracker:getParent() then tracker:close() else openTracker() end
end

function trackSelected()
    if not window then return end
    local name = showing
    if not name then
        local selected = window:getChildById('questList'):getFocusedChild()
        name = selected and selected.questName
    end
    if name and not isTracked(name) then
        table.insert(tracked, name)
        saveTracked()
    end
    openTracker()
end

function onTrackerOpen()
    if refreshEvent then removeEvent(refreshEvent) end
    -- o 7.4 não avisa quando um QuestValue muda: atualiza de tempos em tempos
    refreshEvent = cycleEvent(function()
        if tracker and tracker:isVisible() and #tracked > 0 then request() end
    end, 30000)
end

function onTrackerClose()
    if refreshEvent then removeEvent(refreshEvent); refreshEvent = nil end
end

-- Ciclo de vida ---------------------------------------------------------------------------
local function onGameStart()
    quests = {}
    details = {}
    loadTracked()
    if tracker and tracker:isVisible() and #tracked > 0 then
        scheduleEvent(request, 1000)
    end
    fillTracker()
end

local function onGameEnd()
    hide()
    quests = {}
    details = {}
end

function init()
    window = g_ui.displayUI('questlog74')
    window:hide()
    tracker = g_ui.loadUI('questtracker74')
    tracker:setup()
    tracker:keepBasicButtons()
    tracker:setContentMinimumHeight(40)
    tracker:close()
    ProtocolGame.registerOpcode(OPCODE, onQuestLog)
    connect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    if g_game.isOnline() then onGameStart() end
end

function terminate()
    ProtocolGame.unregisterOpcode(OPCODE)
    disconnect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    onTrackerClose()
    if window then window:destroy(); window = nil end
    if tracker then tracker:destroy(); tracker = nil end
end
