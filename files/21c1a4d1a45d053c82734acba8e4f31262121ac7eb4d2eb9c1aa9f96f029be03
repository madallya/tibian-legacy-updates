local PAGE_SIZE = 15
local CHARM_RUNE = { [0] = 0, 1, 2, 4, 5, 6, 8, 7, 9, 10, 11, 12, 15, 17, 18 }
local OCCURRENCE = { 'Common', 'Uncommon', 'Rare', 'Very Rare' }
local RARITY = { [0] = 'Common', 'Uncommon', 'Semi-Rare', 'Rare', 'Very Rare' }
-- barras de resistência, na ordem da tela; bit = imunidade mandada pelo servidor
local RESISTS = {
    { 'physical', 'Physical', 8 }, { 'earth', 'Earth', 2 }, { 'fire', 'Fire', 1 }, { 'death', 'Death', 16 },
    { 'energy', 'Energy', 4 }, { 'holy', 'Holy', 0 }, { 'ice', 'Ice', 0 }, { 'healing', 'Healing', 0 },
}
local GOLD = { [3031] = 1, [3035] = 100, [3043] = 10000 } -- ids do servidor (gold, platinum, crystal)
local GOLD74 = { [2148] = 1, [2152] = 100, [2160] = 10000 } -- ids do cliente 7.4

local window
local tracker
local races = {}        -- lista do servidor
local byRace = {}
local freePoints, earnedPoints = 0, 0
local page = 1
local filter = ''
local currentTab = 'bestiary'
local detailRace
local detail            -- ficha aberta (resposta 8)
local charms = {}
local completed = {}
local selectedCharm
