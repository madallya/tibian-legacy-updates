local function waitAnswer()
    busy = true
    resultText, newAttrText = '', nil
    refresh()
    -- se a resposta nao vier (queda), o botao volta
    later(WAIT_MS, function() if busy then busy = false; refresh() end end)
end

-- 27/11 (dono): cada barra leva 1,5 s (a barra sobe ao lado do item). So no fim o pedido vai ao
-- servidor; fechar a forja, trocar de aba ou apertar Stop antes nao faz a barra nem gasta material.
local function smeltable(r)
    local n = 1000
    for _, m in ipairs(r.mats) do n = math.min(n, math.floor(m.have / m.need)) end
    return n
end

function startChannel(code, left)
    local _, r = byKey(recipesOf('smelt'), 'code', code)
    if not r or smeltable(r) < 1 or shop.level < r.skill then channel = nil; refresh(); return end
    left = math.min(left, smeltable(r))
    channel = { code = code, left = left }
    local bar, fill = child('channelBar'), child('channelFill')
    bar:setVisible(true); bar:raise()
    local full = bar:getWidth() - 2
    fill:setWidth(0)
    resultText = ''
    refresh()
    local my = channel
    local steps = math.floor(CHANNEL_MS / CHANNEL_STEP)
    for k = 1, steps do
        later(k * CHANNEL_STEP, function()
            if channel ~= my then return end
            fill:setWidth(math.floor(full * k / steps))
            if k == steps then
                local ok = send(function(msg)
                    msg:addU8(4); msg:addU8(RECIPE_TAB.smelt); msg:addU8(code); msg:addU8(0); msg:addU8(1)
                end)
                if ok then lastAction = { tab = 'smelt' }; waitAnswer() else channel = nil; bar:setVisible(false); refresh() end
            end
        end)
    end
end

function stopChannel()
    if not channel then return end
    stopEvents()
    busy = false
    resultText, resultColor = tr('Smelting stopped.'), '#c0c0c0'
    refresh()
end

local function sendRecipe(times)
    local _, r = byKey(recipesOf(tab), 'code', sel[tab])
    if not r then return end
    local cat = (r.chanceCat ~= 0xFFFF) and useCat and shop.catalysts > 0
    local ok = send(function(msg)
        msg:addU8(4); msg:addU8(RECIPE_TAB[tab]); msg:addU8(r.code); msg:addU8(cat and 1 or 0); msg:addU8(times)
    end)
    if ok then lastAction = { tab = tab }; waitAnswer() end
end

local function sendItem(sub, list, key, extra)
    local idx, it = byKey(list, 'serial', key)
    if not it then return end
    local ok = send(function(msg)
        msg:addU8(sub); msg:addU8(idx - 1); msg:addU16(it.id); msg:addU32(it.serial)
        if extra then msg:addU8(extra) end
    end)
    return ok
end

local function confirm(title, text, yes)
    closeBox()
    local function no() closeBox() end
    local function ok() closeBox(); yes() end
    confirmBox = displayGeneralBox(title, text, { { text = tr('No'), callback = no }, { text = tr('Yes'), callback = ok } }, ok, no)
end

function action()
    if tab == 'smelt' and channel then stopChannel(); return end
    if busy or not state then return end
    local btnId = (tab == 'services') and 'soulButton' or 'attuneButton'
    if not child(btnId):isEnabled() then return end
    if tab == 'attune' then
        local idx, it = byKey(state.items, 'serial', sel.attune)
        if not it then return end
        local ok = send(function(msg)
            msg:addU8(2); msg:addU8(idx - 1); msg:addU16(it.id); msg:addU32(it.serial)
        end)
        if ok then lastAction = { tab = 'attune' }; waitAnswer() end
    elseif tab == 'smelt' then
        if channel then stopChannel() else startChannel(sel.smelt, 1) end
    elseif RECIPE_TAB[tab] then
        sendRecipe(1)
    elseif tab == 'services' then
        local attr = selAttr
        if sendItem(7, shop.services, sel.services, attr - 1) then
            lastAction = { tab = 'services', attr = attr }; waitAnswer()
        end
    elseif tab == 'salvage' then
        askSalvage()
    end
end

