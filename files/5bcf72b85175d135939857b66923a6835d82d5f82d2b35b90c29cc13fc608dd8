function askSalvage()
    if busy or not shop or tab ~= 'salvage' then return end
    local _, it = byKey(shop.salvage, 'serial', sel.salvage)
    if not it or it.npc then return end
    local key = sel.salvage
    local text = tr('Salvage your %s? You get %d to %d metal scrap.', titleCase(it.name), it.min or it.scrap, it.scrap)
    if it.attrs > 0 then text = text .. '\n' .. tr('Its %d attributes are lost.', it.attrs) end
    if it.equipped then text = text .. '\n' .. tr('You are wearing this item.') end
    confirm(tr('Salvage'), text, function()
        if busy or tab ~= 'salvage' or sel.salvage ~= key then return end
        if sendItem(5, shop.salvage, key) then lastAction = { tab = 'salvage', scrap = it.scrap }; waitAnswer() end
    end)
end

-- o item arrastado para o slot do Salvage: o servidor diz qual e (sub 8 -> sub 6)
local function onSlotDrop(self, widget, mousePos)
    if not window or not window:isVisible() or not shop or tab ~= 'salvage' or busy then return false end
    local item = widget and widget.currentDragThing
    if not item or not item.isItem or not item:isItem() then return false end
    if UIDragIcon and UIDragIcon.hide then UIDragIcon:hide() end
    local pos = item:getPosition()
    if not pos or pos.x ~= 65535 then
        resultText, resultColor = tr('You must carry the item.'), RED
        refresh()
        return true
    end
    closeBox()
    send(function(msg) msg:addU8(8); msg:addU16(pos.x); msg:addU16(pos.y); msg:addU8(pos.z) end)
    return true
end

function onSalvageDropped(index, text)
    if not shop or tab ~= 'salvage' or busy then return end
    local it = (index ~= 255) and shop.salvage[index + 1] or nil
    if not it then
        resultText, resultColor = (text ~= '' and text or tr('This item cannot be salvaged.')), RED
        refresh()
        return
    end
    sel.salvage = it.serial
    resultText, resultColor, newAttrText = '', '#c0c0c0', nil
