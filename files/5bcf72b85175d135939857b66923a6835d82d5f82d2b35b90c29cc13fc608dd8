-- o que a tentativa pediu (para a cor do pulso e o atributo novo)
local lastAction

local function onResult(r)
    local ch = channel
    stopEvents()
    -- 27/11 (dono): o resultado aparece embaixo so no fim da animacao, verde no sucesso e vermelho na falha
    resultText, resultColor = '', '#c0c0c0'
    newAttrText = nil
    if not r.tried then
        -- recusado: nada foi gasto
        resultText, resultColor = r.msg, RED
        busy = false
        applyPending()
        refresh()
        return
    end
    -- o item ainda com a moldura antiga enquanto o pulso toca; no fim, o estado novo.
    -- busy de novo: o resultado pode chegar depois dos WAIT_MS (K-20261126-5 do VEX); sem isso o
    -- botao fica ligado durante o pulso e o estado novo entra antes do fim
    busy = true
    local act = lastAction or { tab = 'attune' }
    local color, finalColor
    if act.tab == 'attune' then
        local _, cur = byKey(state.items, 'serial', sel.attune)
        local n = cur and #cur.attrs or 0
        color = r.success and PULSE_COLOR[math.min(n + 1, 5)] or 'falha'
        finalColor = r.success and NEW_ATTR_COLOR[math.min(n + 1, 5)] or RED
    else
        color = r.success and 'verde' or 'falha'
        finalColor = r.success and NEW_ATTR_COLOR[2] or RED
        if act.tab == 'services' and act.void then color, finalColor = 'cinza', NEW_ATTR_COLOR[1] end
    end
    refresh()
    local function done()
        busy = false
        applyPending()
        resultText, resultColor = r.msg, r.success and GOOD or RED
        if act.tab == 'attune' and r.success then
            local _, c2 = byKey(state.items, 'serial', sel.attune)
            if c2 then newAttrText = c2.attrs[#c2.attrs] end
        elseif act.tab == 'services' and r.success and act.attr then
            local _, c2 = byKey(shop and shop.services or {}, 'serial', sel.services)
            if c2 then newAttrText = c2.attrs[act.attr] end
            if not c2 then sel.services, selAttr = nil, nil end
        end
        refresh()
    end
    -- Smelt nunca falha: sem a borda dourada; no Smelt all a proxima barra comeca sozinha
    if act.tab == 'smelt' then
        done()
        if ch and ch.left > 1 and tab == 'smelt' and sel.smelt == ch.code and window:isVisible() then
            startChannel(ch.code, ch.left - 1)
        end
    elseif act.tab == 'salvage' then
        -- 27/11: no Salvage o indice da resposta e quanto scrap saiu
        playSalvage(r.index or 0, function()
            sel.salvage = nil
            done()
        end)
    else
        playForge(color, finalColor, done)
    end
end

-- ------------------------------------------------------------------ servidor
local function readState(msg)
    local st = { items = {}, sigils = {}, table = {} }
    st.open = msg:getU8() == 1
    for _ = 1, msg:getU8() do
        local it = { id = msg:getU16(), name = msg:getString(), class = msg:getU8(), slot = msg:getU8(),
            equipped = msg:getU8() == 1, serial = msg:getU32(), attrs = {} }
        for _ = 1, msg:getU8() do table.insert(it.attrs, msg:getString()) end
        table.insert(st.items, it)
    end
    for _ = 1, 7 do
        table.insert(st.sigils, { id = msg:getU16(), name = msg:getString(), whole = msg:getU16(), cracked = msg:getU16() })
    end
    st.gold = msg:getU32()
    for _ = 1, 5 do
        table.insert(st.table, { chance = msg:getU16(), fee = msg:getU32() })
    end
    return st
end

local function readShop(msg)
    local sh = { recipes = {}, services = {}, salvage = {}, soulFee = {} }
    sh.member = msg:getU8()
    sh.level = msg:getU8()
    sh.catalystId = msg:getU16()
    sh.catalysts = msg:getU16()
    for _ = 1, msg:getU8() do
        local r = { tab = msg:getU8(), code = msg:getU8(), product = msg:getU16(), name = msg:getString(),
            skill = msg:getU8(), chance = msg:getU16(), chanceCat = msg:getU16(), fee = msg:getU32(), mats = {} }
        for _ = 1, msg:getU8() do
            table.insert(r.mats, { id = msg:getU16(), name = msg:getString(), need = msg:getU16(), have = msg:getU16() })
        end
        table.insert(sh.recipes, r)
    end
    sh.voidId = msg:getU16(); sh.voids = msg:getU16(); sh.voidFee = msg:getU32()
    sh.soulId = msg:getU16(); sh.souls = msg:getU16()
    for i = 1, 3 do sh.soulFee[i] = msg:getU32() end
    for _ = 1, msg:getU8() do
        local it = { id = msg:getU16(), name = msg:getString(), serial = msg:getU32(), attrs = {} }
        for _ = 1, msg:getU8() do table.insert(it.attrs, msg:getString()) end
        table.insert(sh.services, it)
    end
    sh.scrapId = msg:getU16()
    sh.salvageChance = msg:getU16()
    for _ = 1, msg:getU8() do
        table.insert(sh.salvage, { id = msg:getU16(), name = msg:getString(), serial = msg:getU32(), attrs = msg:getU8(),
            scrap = msg:getU16(), min = msg:getU16(), equipped = msg:getU8() == 1, npc = msg:getU8() == 1 })
    end
    return sh
end

