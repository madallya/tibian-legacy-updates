local function onForge(protocol, msg)
    local sub = msg:getU8()
    if sub == 1 then
        local st = readState(msg)
        if st.open then
            stopEvents()
            closeBox()
            busy, pendingState, pendingShop = false, nil, nil
            state = st
            shop = nil -- o sub 4 vem logo depois (com a fase 2)
            sel = {}
            selAttr = nil
            tab = 'attune'
            resultText, resultColor, newAttrText = '', '#c0c0c0', nil
            refresh()
            window:show()
            window:raise()
            window:focus()
        elseif busy then
            pendingState = st -- aplicado no fim do pulso
        else
            state = st
            refresh()
        end
    elseif sub == 2 then
        onResult({ tried = msg:getU8() == 1, success = msg:getU8() == 1, index = msg:getU8(), msg = msg:getString() })
    elseif sub == 3 then
        msg:getString() -- o motivo tambem vai para o console (mensagem do servidor)
        hideWindow()
    elseif sub == 4 then
        local sh = readShop(msg)
        if busy then pendingShop = sh else shop = sh; refresh() end
    elseif sub == 5 then
        skills = { member = msg:getU8(), bs = msg:getU8(), bsPct = msg:getU8(), mn = msg:getU8(), mnPct = msg:getU8() }
        pushSkills()
    elseif sub == 6 then
        onSalvageDropped(msg:getU8(), msg:getString())
    elseif sub == 7 then
        local f = {}
        for _ = 1, msg:getU8() do
            local serial = msg:getU32()
            local e = { text = msg:getString(), attrs = {} }
            for _ = 1, msg:getU8() do table.insert(e.attrs, msg:getString()) end
            f[serial] = e
        end
        fichas = f
        if not busy then refresh() end
    end
end

