-- ------------------------------------------------------------------ a borda dourada (so visual)
-- 26/11 (dono): na tentativa, uma borda dourada acende embaixo do item, sobe pelos 2 lados e
-- fecha no meio do topo; ali brilha (pisca claro/dourado) e fica na cor do resultado (a cor
-- do novo atributo no sucesso, vermelho na falha), com o pulso do MORPH em 2x por cima.
local FX = { 'fxBottom', 'fxLeft', 'fxRight', 'fxTopL', 'fxTopR' }
local GOLD, FLASH = '#f2c94c', '#fff4c8'
local FX_STEP = 20 -- ms por quadro da borda

local function fxSet(color, visible)
    for _, id in ipairs(FX) do
        local w = child(id)
        if w then
            if color then w:setBackgroundColor(color) end
            if visible ~= nil then w:setVisible(visible) end
        end
    end
end

local function playForge(color, finalColor, onEnd)
    local full = child('itemSlot'):getWidth() + 6 -- a borda fica 3 px para fora
    local half = math.ceil(full / 2)
    child('fxBottom'):setWidth(0)
    child('fxLeft'):setHeight(0)
    child('fxRight'):setHeight(0)
    child('fxTopL'):setWidth(0)
    child('fxTopR'):setWidth(0)
    fxSet(GOLD, true)
    for _, id in ipairs(FX) do child(id):raise() end
    local t = 0
    -- 1) acende embaixo, do meio para os cantos
    for k = 1, 5 do
        later(t + k * FX_STEP, function() child('fxBottom'):setWidth(math.floor(full * k / 5)) end)
    end
    t = t + 5 * FX_STEP
    -- 2) sobe pelos 2 lados
    local up = 20
    for k = 1, up do
        later(t + k * FX_STEP, function()
            local h = math.floor(full * k / up)
            child('fxLeft'):setHeight(h)
            child('fxRight'):setHeight(h)
        end)
    end
    t = t + up * FX_STEP
    -- 3) fecha no topo, dos cantos para o meio
    local top = 10
    for k = 1, top do
        later(t + k * FX_STEP, function()
            local w = math.floor(half * k / top)
            child('fxTopL'):setWidth(w)
            child('fxTopR'):setWidth(w)
        end)
    end
    t = t + top * FX_STEP
    -- 4) juntou no meio: brilha (pisca claro / dourado)
    for k = 1, 6 do
        later(t + k * 80, function() fxSet((k % 2 == 1) and FLASH or GOLD) end)
    end
    t = t + 6 * 80
    -- 5) a cor do resultado e o pulso do MORPH (2x) por cima
    later(t, function()
        fxSet(finalColor)
        local p = child('pulse')
        p:setImageSource('/game_forge74/images/pulso_' .. color .. '_1')
        p:setVisible(true)
        p:raise()
    end)
    for k = 2, PULSE_FRAMES do
        later(t + (k - 1) * PULSE_MS, function()
            child('pulse'):setImageSource('/game_forge74/images/pulso_' .. color .. '_' .. k)
        end)
    end
    later(t + PULSE_FRAMES * PULSE_MS + 150, function()
        child('pulse'):setVisible(false)
        fxSet(nil, false)
        if onEnd then onEnd() end
    end)
end

-- 27/11 (dono): a quebra. O item treme no slot; no sucesso o Metal Scrap aparece no mesmo slot
-- com fade; na falha o item some (fade) e o slot fica vazio.
local SHAKE = { 3, -3, 2, -3, 3, -2, 2, -2, 1, -1, 0 }
local SHAKE_MS, FADE_STEPS, FADE_MS, SHOW_MS = 45, 10, 45, 1500

function playSalvage(amount, onEnd)
    local slot = child('salSlot')
    local t = 0
    -- 27/11 (dono): so o slot treme (nada fica preso a ele)
    for k, o in ipairs(SHAKE) do
        later(t + k * SHAKE_MS, function()
            slot:setMarginLeft(o)
            slot:setMarginTop(((k % 2 == 0) and 1 or -1) * math.min(math.abs(o), 1))
        end)
    end
    t = t + #SHAKE * SHAKE_MS
    later(t, function() slot:setMarginLeft(0); slot:setMarginTop(0) end)
    -- o Metal Scrap aparece no mesmo slot (fade), fica um tempo e some (fade)
    later(t + 20, function()
        slot:setOpacity(0)
        setFrame(slot, 0)
        if amount > 0 then
            slot:setItemId(shop and shop.scrapId or 0)
            setCount(slot, amount)
        else
            slot:setItemId(0)
        end
    end)
    for k = 1, FADE_STEPS do
        later(t + 20 + k * FADE_MS, function() slot:setOpacity(k / FADE_STEPS) end)
    end
    t = t + 20 + FADE_STEPS * FADE_MS + SHOW_MS
    for k = 1, FADE_STEPS do
        later(t + k * FADE_MS, function() slot:setOpacity(1 - k / FADE_STEPS) end)
    end
    later(t + (FADE_STEPS + 1) * FADE_MS, function()
        slot:setItemId(0); setCount(slot, 1); slot:setOpacity(1)
        if onEnd then onEnd() end
    end)
end

local function applyPending()
