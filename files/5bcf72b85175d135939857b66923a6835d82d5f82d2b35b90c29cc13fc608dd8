end

function showTab(name)
    if channel then stopChannel() end
    if busy or not shop then return end
    if not TAB_ID[name] then return end
    if SMITH_ONLY[name] and not isMember() then
        displayInfoBox(tr('Forge Anvil'), tr('Only blacksmiths can use this. Reach blacksmithing %d by salvaging items and join the profession with Brokk in Kazordoon or Sigrun in Edron.', 20))
        return
    end
    closeBox()
    tab = name
    selAttr = nil
    resultText, resultColor, newAttrText = '', '#c0c0c0', nil
    refresh()
end

-- compatibilidade com a fase 1 (otui antigo)
function attune()
    if tab == 'attune' then action() end
end

function closeByPlayer()
    if window and window:isVisible() then
        send(function(msg) msg:addU8(3) end)
    end
    hideWindow()
end

function refreshView()
    refresh()
end

function toggleCatalyst()
    if busy or not shop or shop.catalysts == 0 then return end
    useCat = not useCat
    refresh()
end

local function hello()
    send(function(msg) msg:addU8(1); msg:addU8(VERSION) end)
end

local function setTabIcons()
    -- desenhos das abas do MORPH (27/11, escolha do dono): images/aba_<aba>.png
    for _, t in ipairs(TABS) do
        local w = child(TAB_ID[t])
        if w then
            w:getChildById('icon'):setVisible(false)
            w:getChildById('art'):setImageSource('/game_forge74/images/aba_' .. t)
        end
    end
end

local function onGameStart()
    hideWindow()
    state, shop, skills = nil, nil, nil
    pushSkills()
    scheduleEvent(hello, 300)
end

local function onGameEnd()
    hideWindow()
    state, shop, skills = nil, nil, nil
    pushSkills()
end

function init()
    -- 26/11 (dono): dentro do painel do jogo (como as mensagens do textmessage). Solta no
    -- rootWidget, com a janela em foco as teclas do jogo ligadas ao painel (Ctrl+Q/Ctrl+L
    -- para sair, etc.) nao chegavam nele.
    window = g_ui.displayUI('forge74', modules.game_interface.getRootPanel())
    window:hide()
    setTabIcons()
    child('salSlot').onDrop = onSlotDrop
    -- 27/11 (dono): clique direito tira o item do slot (nunca com a confirmacao aberta ou na quebra)
    child('salSlot').onMouseRelease = function(self, pos, button)
        if button ~= MouseRightButton then return false end
        if busy or confirmBox or tab ~= 'salvage' or not sel.salvage then return true end
        sel.salvage = nil
        resultText = ''
        refresh()
        return true
    end
    child('tabBar').onGeometryChange = function() layoutTabs() end
    ProtocolGame.registerOpcode(OPCODE, onForge)
    connect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    if g_game.isOnline() then onGameStart() end
end

function terminate()
    stopEvents()
    closeBox()
    disconnect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    ProtocolGame.unregisterOpcode(OPCODE)
    if window then window:destroy() end
    window = nil
    state, shop = nil, nil
end

-- so para teste (previa sem servidor): mostra um estado e um resultado falsos
function _preview(st, sel1, sh, t)
    stopEvents()
    busy, pendingState, pendingShop = false, nil, nil
    state = st
    shop = sh
    tab = t or 'attune'
    sel = { attune = sel1 }
    resultText, newAttrText = '', nil
    refresh()
    window:show()
end

function _previewSelect(t, key, attr)
    tab = t
    sel[t] = key
    selAttr = attr
    refresh()
end

function _previewResult(r, st2, sh2, act)
    busy = true
    pendingState = st2
    pendingShop = sh2
    lastAction = act or { tab = tab }
    onResult(r)
end
