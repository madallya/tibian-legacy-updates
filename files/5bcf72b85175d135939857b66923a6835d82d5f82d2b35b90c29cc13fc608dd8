-- Forge Anvil do Telmora. Tudo vem do servidor pelo comando 0xF8 (protocolo em
-- src/game/sigils.hh do servidor); aqui so se mostra e se pede. O servidor sorteia e
-- grava na hora do pedido; o pulso de cor no slot e so visual e mostra o resultado que
-- ja chegou. Enquanto o pedido esta no ar e o pulso toca, os botoes ficam desligados
-- (um 2o clique nao manda nada; o servidor tambem ignora).
-- Layout padrao Miracle, sem bigorna (dono, 26/11; doc claude/sigils-tela-forja-rascunho.md).
-- Pulso do MORPH: 12 quadros de 38 x 38 a 83 ms, na cor da moldura nova (sucesso) ou
-- vermelho (falha); no fim do sucesso a moldura do slot fica na cor nova.
-- Fase 2 (27/11; doc claude/profissoes-telmora.md v4): hello versao 2 e as abas Forge, Smelt,
-- Repair, Services e Salvage (sub 4 do servidor) e as barras de Blacksmithing e Mining na
-- janela de Skills (sub 5). Servidor sem a fase 2: so a aba Attune, como antes.

local OPCODE = 0xF8
local VERSION = 2
local PULSE_FRAMES = 12
local PULSE_MS = 83
local WAIT_MS = 4000 -- sem resposta do servidor: libera o botao

local RED = '#d33c3c'
local OK_COLOR = '#dfdfdf'
-- 26/11 (VEX): textos inteiros para o tr() (o ordinal muda com a lingua)
local ORDINAL = { '1st attribute', '2nd attribute', '3rd attribute', '4th attribute', '5th attribute' }
-- cor do pulso pelo numero de atributos depois do sucesso (attr_frames: 1 cinza ... 5 dourado)
local PULSE_COLOR = { 'cinza', 'verde', 'azul', 'roxo', 'dourado' }
local NEW_ATTR_COLOR = { '#d0d0d0', '#3ddc4a', '#3fb6f0', '#d58be0', '#f2e04a' }

-- abas: a aba do protocolo (sub 4) e se e so do ferreiro
local TABS = { 'attune', 'forge', 'smelt', 'repair', 'services', 'salvage' }
local TAB_ID = { attune = 'tabAttune', forge = 'tabForge', smelt = 'tabSmelt', repair = 'tabRepair',
    services = 'tabServices', salvage = 'tabSalvage' }
local RECIPE_TAB = { forge = 1, smelt = 2, repair = 3 }
local SMITH_ONLY = { forge = true, smelt = true, repair = true }
local LIST_LABEL = { attune = 'Equipment you carry', forge = 'Recipes', smelt = 'Bars',
    repair = 'Cracked sigils', services = 'Items with 3 or more attributes', salvage = 'Items you can salvage' }
local ACTION_TEXT = { attune = 'Attune', forge = 'Forge', smelt = 'Smelt', repair = 'Repair',
    services = 'Reshape', salvage = 'Salvage' }

local window
local state        -- o ultimo estado do servidor (sub 1)
local shop         -- a oficina (sub 4); nil = servidor sem a fase 2
local tab = 'attune'
local sel = {}     -- o escolhido de cada aba (serie ou codigo)
local selAttr      -- Services: o atributo escolhido para a Sigil Soul (1..)
local busy = false -- pedido no ar ou pulso tocando
local pendingState, pendingShop
local events = {}
local resultText, resultColor = '', '#c0c0c0'
local newAttrText  -- atributo que acabou de pegar (fica colorido na lista)
local confirmBox
local skills       -- sub 5: { member, bs, bsPct, mn, mnPct }
local fichas = {}  -- sub 7 (27/11): serie -> { text = ficha do item, attrs = { ... } }
local useCat = false -- 27/11 (dono): o botao do primal catalyst (apertado = usa)
local channel      -- 27/11 (dono): o Smelt em andamento { code, left, t0 }
local CHANNEL_MS, CHANNEL_STEP = 1500, 50
local GOOD = '#5fd35f' -- resultado bom na linha de baixo (27/11, dono); o ruim e o RED

-- ------------------------------------------------------------------ utilidades
local function child(id)
    return window and window:recursiveGetChildById(id) or nil
end

local function send(fill)
    local protocol = g_game.getProtocolGame()
    if not protocol or not g_game.isOnline() then return false end
    local msg = OutputMessage.create()
    msg:addU8(OPCODE)
    fill(msg)
    protocol:send(msg)
    return true
end

local function fmt(n)
    local s = tostring(math.floor(n or 0))
    local out = s:reverse():gsub('(%d%d%d)', '%1,'):reverse()
    return (out:gsub('^,', ''))
end

local function pct(c)
    local v = (c or 0) / 100
    if v == math.floor(v) then return tostring(math.floor(v)) .. '%' end
    return string.format('%.1f%%', v)
end

local function titleCase(s)
    return (s:gsub('(%a)([%w\']*)', function(a, b) return a:upper() .. b end))
end

local function later(ms, fn)
    local e = scheduleEvent(fn, ms)
    table.insert(events, e)
    return e
end

local function closeBox()
    if confirmBox then confirmBox:destroy(); confirmBox = nil end
end

local function stopEvents()
    for _, e in ipairs(events) do removeEvent(e) end
    events = {}
    local p = child('pulse')
    if p then p:setVisible(false) end
    local slot = child('salSlot')
    if slot then
        slot:setMarginLeft(0); slot:setMarginTop(0); slot:setOpacity(1)
    end
    channel = nil
    local bar = child('channelBar')
    if bar then bar:setVisible(false) end
    for _, id in ipairs({ 'fxBottom', 'fxLeft', 'fxRight', 'fxTopL', 'fxTopR' }) do
        local w = child(id)
        if w then w:setVisible(false) end
    end
end

local function setFrame(widget, n)
    if ItemsDatabase and ItemsDatabase.setAttrFrame then
        -- 27/11 (dono): no slot grande a moldura vai no widget de cima (so a borda, sem esticar o fundo)
        local big = widget.getChildById and widget:getChildById('bigFrame') or nil
        ItemsDatabase.setAttrFrame(big or widget, n)
    end
end

local function setCount(widget, n)
    widget:setItemCount(math.max(1, n or 1))
    if widget.setShowCount then widget:setShowCount((n or 0) > 1) end
end

local function isMember()
    return shop and (shop.member % 2 == 1) or false
end

local function byKey(list, key, value)
    if not list or value == nil then return nil end
    for i, it in ipairs(list) do
        if it[key] == value then return i, it end
    end
    return nil
end

local function recipesOf(t)
    local out = {}
    if not shop then return out end
    for _, r in ipairs(shop.recipes) do
        if r.tab == RECIPE_TAB[t] then table.insert(out, r) end
    end
    return out
end

-- a lista da esquerda de cada aba: { id, frame, dim, count, tip, key }
local function listOf(t)
    local out = {}
    if t == 'attune' then
        for _, it in ipairs(state and state.items or {}) do
            local n = #it.attrs
            table.insert(out, { id = it.id, frame = math.min(n, 5), dim = (n >= it.class or n >= 5), key = it.serial,
                tip = titleCase(it.name) .. (n > 0 and ('\n' .. table.concat(it.attrs, '\n')) or '') })
        end
    elseif RECIPE_TAB[t] then
        for _, r in ipairs(recipesOf(t)) do
            local e = { id = r.product, frame = 0, key = r.code, tip = titleCase(r.name) }
            -- 27/11 (dono): apagada quando falta skill, material ou ouro (no Repair tambem: so o
            -- trincado nao basta)
            local ok = shop.level >= r.skill and (state and state.gold or 0) >= r.fee
            for _, m in ipairs(r.mats) do if m.have < m.need then ok = false end end
            e.dim = not ok
            if t == 'repair' then
                local m = r.mats[1]
                e.id, e.count = m.id, m.have
                e.tip = titleCase(m.name)
            elseif t == 'smelt' and r.code == 1 then
                e.tip = tr('%s (with metal scrap)', titleCase(r.name))
            end
            e.order = #out
            table.insert(out, e)
        end
        -- 27/11 (dono): primeiro o que da para fazer agora (com tudo), na ordem de sempre
        table.sort(out, function(a, b)
            if (a.dim and true or false) ~= (b.dim and true or false) then return not a.dim end
            return a.order < b.order
        end)
    elseif t == 'services' then
        for _, it in ipairs(shop and shop.services or {}) do
            table.insert(out, { id = it.id, frame = math.min(#it.attrs, 5), key = it.serial,
                tip = titleCase(it.name) .. '\n' .. table.concat(it.attrs, '\n') })
        end
    elseif t == 'salvage' then
        for _, it in ipairs(shop and shop.salvage or {}) do
            table.insert(out, { id = it.id, frame = math.min(it.attrs, 5), key = it.serial, dim = it.npc,
                tip = titleCase(it.name) })
        end
    end
    return out
end

-- ------------------------------------------------------------------ desenho
local function fillList(entries)
    local panel = child('itemsPanel')
    local kids = panel:getChildren()
    for i, e in ipairs(entries) do
        local w = kids[i]
        if not w then w = g_ui.createWidget('Forge74ListSlot', panel) end
        w:setItemId(e.id)
        setCount(w, e.count)
        w:setTooltip(e.tip)
        setFrame(w, e.frame or 0)
        w:setOpacity(e.dim and 0.45 or 1)
        w:getChildById('selection'):setVisible(e.key == sel[tab])
        local key = e.key
        w.onClick = function()
            if busy then return end
            if tab == 'salvage' then
                resultText, resultColor = tr('Drag the item from your inventory into the slot.'), '#c0c0c0'
                modules.game_forge74.refreshView()
                return
            end
            sel[tab] = key
            selAttr = nil
            resultText, resultColor, newAttrText = '', '#c0c0c0', nil
            modules.game_forge74.refreshView()
        end
    end
    for i = #entries + 1, #kids do kids[i]:destroy() end
end

-- 27/11 (dono): a lista do Smelt em linhas, com o desenho e o nome da barra
local function fillRows(entries)
    local panel = child('rowsPanel')
    local kids = panel:getChildren()
    for i, e in ipairs(entries) do
        local w = kids[i]
        if not w then w = g_ui.createWidget('Forge74ListRow', panel) end
        w:getChildById('slot'):setItemId(e.id)
        setCount(w:getChildById('slot'), e.count)
        w:getChildById('name'):setText(e.tip)
        w:setOpacity(e.dim and 0.45 or 1)
        w:getChildById('selection'):setVisible(e.key == sel[tab])
        local key = e.key
        w.onClick = function()
            if busy or channel then return end
            sel[tab] = key
            resultText, resultColor, newAttrText = '', '#c0c0c0', nil
            modules.game_forge74.refreshView()
        end
    end
    for i = #entries + 1, #kids do kids[i]:destroy() end
end

-- 27/11 (dono): as 6 abas com o mesmo tamanho, preenchendo a linha, com o desenho e o nome no meio
function layoutTabs()
    local bar = child('tabBar')
    if not bar or not bar:isVisible() then return end
    local total = bar:getWidth()
    if total <= 0 then return end
    local n = #TABS
    -- cada aba encosta na anterior com 2 px por cima (anchors.left: prev.right = x + w - 1, e margin-left -1)
    local OV = 2
    local w = math.floor((total + OV * (n - 1)) / n)
    local used = 0
    for i, t in ipairs(TABS) do
        local tw = (i < n) and w or (total + OV * (n - 1) - used)
        local b = child(TAB_ID[t])
        b:setWidth(tw)
        used = used + tw
        local textW = 0
        local ok, size = pcall(function() return b:getTextSize() end)
        if ok and size and size.width then textW = size.width end
        local left = math.max(2, math.floor((tw - (32 + 5 + textW)) / 2))
        local art = b:getChildById('art')
        if art then art:setMarginLeft(left) end
        b:setTextOffset({ x = left + 37, y = 0 })
    end
    local rest = child('tabBarRest')
    if rest then rest:setVisible(false) end
end

local function setMat(row, id, name, need, have)
    row:getChildById('slot'):setItemId(id or 0)
    row:getChildById('name'):setText(name or '')
    local h = row:getChildById('have')
    -- o nome ja diz quanto precisa ("4x Iron Bar"); aqui so quanto tem, em vermelho se falta
    h:setText(have and tr('You have %s', fmt(have)) or '')
    h:setColor((have and have < (need or 1)) and RED or '#c0c0c0')
end

local function showPanels()
    child('attunePanel'):setVisible(tab == 'attune')
    child('recipePanel'):setVisible(RECIPE_TAB[tab] ~= nil)
    child('servicesPanel'):setVisible(tab == 'services')
    child('salvagePanel'):setVisible(tab == 'salvage')
end

local function setAction2(text)
    local b = child('action2Button')
    if text then
        b:setText(text); b:setVisible(true); b:setWidth(64); b:setMarginRight(6)
    else
        b:setVisible(false); b:setWidth(0); b:setMarginRight(0)
    end
end

-- 27/11 (dono): no Services os atributos ficam numa moldura funda; nas outras abas, sem moldura
local function attrFrame(on)
    local list = child('attrList')
    if on then
        list:setBackgroundColor('#00000055')
        list:setBorderWidth(1)
        list:setBorderColorTop('#1a1a1a'); list:setBorderColorLeft('#1a1a1a')
        list:setBorderColorBottom('#5c5c5c'); list:setBorderColorRight('#5c5c5c')
        list:setPadding(1)
    else
        list:setBackgroundColor('alpha')
        list:setBorderWidth(0)
        list:setPadding(0)
    end
end

local function attrLines(lines, color, highlight)
    local list = child('attrList')
    attrFrame(false)
    list:destroyChildren()
    for _, l in ipairs(lines) do
        local w = g_ui.createWidget(l.muted and 'Forge74Muted' or 'Forge74Text', list)
        w:setText(l.text)
        if l.color then w:setColor(l.color) end
    end
end

-- Attune (fase 1) -----------------------------------------------------------
local function refreshAttune()
    local idx = byKey(state.items, 'serial', sel.attune)
    local cur = idx and state.items[idx] or nil
    local n = cur and #cur.attrs or 0
    local full = cur and (n >= cur.class or n >= 5) or false

    local slot = child('itemSlot')
    slot:setItemId(cur and cur.id or 0)
    setFrame(slot, cur and math.min(n, 5) or 0)
    child('itemName'):setText(cur and titleCase(cur.name) or '')
    child('itemDesc'):setText(cur and fichas[cur.serial] and fichas[cur.serial].text or '')
    local lines = {}
    if cur then
        for _, a in ipairs(cur.attrs) do
            table.insert(lines, { text = a, color = (a == newAttrText) and NEW_ATTR_COLOR[math.max(1, math.min(n, 5))] or '#c7c7c7' })
        end
    else
        table.insert(lines, { text = tr('Choose a piece of equipment.'), muted = true })
    end
    attrLines(lines)

    -- o Sigil do slot (a janela escolhe; o jogador nao)
    local sg = cur and state.sigils[cur.slot + 1] or nil
    local sigilSlot = child('sigilSlot')
    if sg then
        -- 26/11 (dono): so o que a tentativa gasta ("1x Mantle Sigil"), sem a quantidade da
        -- mochila; sem Sigil inteiro o desenho continua no slot, apagado (indisponivel)
        child('sigilName'):setText('1x ' .. sg.name)
        child('sigilCount'):setText('')
        sigilSlot:setItemId(sg.id)
        sigilSlot:setOpacity(sg.whole > 0 and 1.0 or 0.35)
        child('sigilCracked'):setText(sg.cracked > 0 and tr('%d cracked: repair at a smith', sg.cracked) or '')
    else
        child('sigilName'):setText('')
        child('sigilCount'):setText('')
        sigilSlot:setItemId(0)
        sigilSlot:setOpacity(1.0)
        child('sigilCracked'):setText('')
    end

    local step = (cur and not full) and state.table[n + 1] or nil
    local payable = step and state.gold >= step.fee or false
    child('nextLabel'):setText(step and tr(ORDINAL[n + 1]) or '')
    child('nextChance'):setText(step and (tr('Chance') .. ' ' .. (step.chance / 100) .. '%') or '')
    child('feeLabel'):setVisible(step ~= nil)
    child('feeValue'):setText(step and tr('%s gold', fmt(step.fee)) or '')
    child('feeValue'):setColor(payable and OK_COLOR or RED)
    child('goldValue'):setText(fmt(state.gold))

    local can = cur and not busy and not full and sg and sg.whole > 0 and payable
    local hint = ''
    if not cur then hint = tr('Choose a piece of equipment.')
    elseif full then hint = tr('This item cannot hold more attributes.')
    elseif sg and sg.whole == 0 then hint = tr('You have no whole %s.', sg.name:lower())
    elseif not payable then hint = tr('You do not have enough gold.') end
    return can, hint
end

-- Forge, Smelt e Repair -----------------------------------------------------
local function refreshRecipe()
    local list = recipesOf(tab)
    local _, r = byKey(list, 'code', sel[tab])
    local slot = child('itemSlot')
    slot:setItemId(r and r.product or 0)
    setFrame(slot, 0)
    child('itemName'):setText(r and titleCase(r.name) or '')
    child('itemDesc'):setText('')
    local lines = {}
    local skillOk = r and shop.level >= r.skill
    if r then
        table.insert(lines, { text = tr('Requires blacksmithing %d', r.skill), color = skillOk and '#c0c0c0' or RED })
        table.insert(lines, { text = tr('Your blacksmithing: %d', shop.level), muted = true })
        if tab == 'repair' then
            table.insert(lines, { text = tr('On failure the cracked sigil is kept.'), muted = true })
        elseif tab == 'forge' then
            table.insert(lines, { text = tr('On failure the materials are lost.'), muted = true })
        else
            table.insert(lines, { text = tr('Smelting always succeeds.'), muted = true })
        end
    else
        table.insert(lines, { text = tr('Choose a recipe.'), muted = true })
    end
    attrLines(lines)

    local mats = child('matList')
    mats:destroyChildren()
    local matsOk = r ~= nil
    if r then
        for _, m in ipairs(r.mats) do
            local row = g_ui.createWidget('Forge74MatRow', mats)
            setMat(row, m.id, string.format('%dx %s', m.need, titleCase(m.name)), m.need, m.have)
            if m.have < m.need then matsOk = false end
        end
    end

    local row = child('catalystRow')
    local catOn = false
    if r and r.chanceCat ~= 0xFFFF then
        row:setVisible(true)
        if shop.catalysts == 0 then useCat = false end
        catOn = useCat
        local btn = child('catalystButton')
        btn:setItemId(shop.catalystId)
        btn:setOpacity(catOn and 1 or 0.45)
        child('catalystCount'):setText(tostring(shop.catalysts))
        btn:setBorderWidth(catOn and 1 or 0)
        btn:setBorderColor('#f2c94c')
        local bonus = pct(r.chanceCat - r.chance)
        btn:setTooltip(tr('Use a primal catalyst (+%s). Consumes 1.', bonus))
        child('catalystText'):setText(tr('Use a primal catalyst (+%s). Consumes 1.', bonus))
        child('catalystText'):setColor(catOn and '#f2c94c' or '#c0c0c0')
    else
        row:setVisible(false)
    end
    local chance = r and (catOn and r.chanceCat or r.chance) or nil
    child('rChanceLabel'):setVisible(r ~= nil)
    child('rChance'):setText(chance and pct(chance) or '')
    child('rFeeLabel'):setVisible(r ~= nil and r.fee > 0)
    child('rFee'):setText((r and r.fee > 0) and tr('%s gold', fmt(r.fee)) or '')
    local payable = not r or state.gold >= r.fee
    child('rFee'):setColor(payable and OK_COLOR or RED)
    child('rGoldLabel'):setVisible(r ~= nil and r.fee > 0)
    child('rGold'):setText((r and r.fee > 0) and fmt(state.gold) or '')

    local can = r and not busy and isMember() and skillOk and matsOk and payable
    local hint = ''
    if not r then hint = tr('Choose a recipe.')
    elseif not skillOk then hint = tr('You need blacksmithing %d.', r.skill)
    elseif not matsOk then hint = tr('You do not have all the materials.')
    elseif not payable then hint = tr('You do not have enough gold.') end
    if tab == 'smelt' then setAction2(tr('Smelt all')) else setAction2(nil) end
    child('action2Button'):setEnabled(can and true or false)
    return can, hint
end

-- Services ------------------------------------------------------------------
local function soulFee(n)
    return shop.soulFee[math.max(1, math.min(n, 5) - 2)] or 0
end

local function refreshServices()
    local _, cur = byKey(shop.services, 'serial', sel.services)
    local n = cur and #cur.attrs or 0
    local slot = child('itemSlot')
    slot:setItemId(cur and cur.id or 0)
    setFrame(slot, cur and math.min(n, 5) or 0)
    child('itemName'):setText(cur and titleCase(cur.name) or '')
    child('itemDesc'):setText(cur and fichas[cur.serial] and fichas[cur.serial].text or '')

    -- os atributos: clicar escolhe o que a Sigil Soul vai mudar
    local list = child('attrList')
    list:destroyChildren()
    attrFrame(true)
    if cur then
        for i, a in ipairs(cur.attrs) do
            local row = g_ui.createWidget('Forge74AttrRow', list)
            local chosen = (i == selAttr)
            row:getChildById('text'):setText(a)
            row:getChildById('text'):setColor((a == newAttrText) and '#f2e04a' or (chosen and '#ffffff' or '#c7c7c7'))
            row:getChildById('radio'):setImageClip(chosen and '0 12 12 12' or '0 0 12 12')
            row:setBackgroundColor(chosen and '#ffffff26' or ((i % 2 == 0) and '#ffffff0d' or 'alpha'))
            row.onClick = function()
                if busy then return end
                selAttr = (selAttr == i) and nil or i
                resultText, newAttrText = '', nil
                modules.game_forge74.refreshView()
            end
        end
    else
        local w = g_ui.createWidget('Forge74Muted', list)
        w:setText(#shop.services == 0 and tr('Items with 3 or more attributes appear here.') or tr('Choose an item.'))
    end

    setMat(child('voidRow'), shop.voidId, 'Void Sigil', nil, shop.voids)
    setMat(child('soulRow'), shop.soulId, 'Sigil Soul', nil, shop.souls)
    child('voidRow'):getChildById('slot'):setOpacity(shop.voids > 0 and 1 or 0.35)
    child('soulRow'):getChildById('slot'):setOpacity(shop.souls > 0 and 1 or 0.35)
    local fs = cur and soulFee(n) or shop.soulFee[1]
    child('voidFee'):setText(tr('%s gold', fmt(shop.voidFee)))
    child('voidFee'):setColor(state.gold >= shop.voidFee and OK_COLOR or RED)
    child('soulFee'):setText(cur and tr('%s gold', fmt(fs)) or
        tr('%s / %s / %s gold', fmt(shop.soulFee[1]), fmt(shop.soulFee[2]), fmt(shop.soulFee[3])))
    child('soulFee'):setColor((not cur or state.gold >= fs) and OK_COLOR or RED)
    child('sGold'):setText(fmt(state.gold))

    local canVoid = cur and not busy and shop.voids > 0 and state.gold >= shop.voidFee
    local canSoul = cur and not busy and selAttr and shop.souls > 0 and state.gold >= fs
    setAction2(nil)
    child('voidButton'):setEnabled(canVoid and true or false)
    child('soulButton'):setEnabled(canSoul and true or false)
    local hint = ''
    if not cur then hint = (#shop.services == 0) and tr('Items with 3 or more attributes appear here.') or tr('Choose an item.')
    elseif not selAttr then hint = tr('Choose the attribute the sigil soul will reshape.')
    elseif shop.souls == 0 then hint = tr('You have no sigil soul.')
    elseif state.gold < fs then hint = tr('You do not have enough gold.') end
    return canSoul, hint
end

-- Salvage -------------------------------------------------------------------
local function refreshSalvage()
    local _, cur = byKey(shop.salvage, 'serial', sel.salvage)
    if not cur then sel.salvage = nil end
    local slot = child('salSlot')
    local lines = child('salLines')
    lines:destroyChildren()
    local function line(text, color, muted)
        local w = g_ui.createWidget(muted and 'Forge74Muted' or 'Forge74Text', lines)
        w:setText(text)
        if color then w:setColor(color) end
    end
    if not busy then
        slot:setItemId(cur and cur.id or 0)
        setCount(slot, 1)
        setFrame(slot, cur and math.min(cur.attrs, 5) or 0)
    end
    child('salDrop'):setVisible(not cur and not busy)
    child('salName'):setText(cur and titleCase(cur.name) or '')
    local f = cur and fichas[cur.serial] or nil
