local statsFiles = { exp = 'hunt74exp', loot = 'hunt74loot', kills = 'hunt74kills' }
local statsTitles = { exp = 'Exp Statistics', loot = 'Loot Statistics', kills = 'Kills Statistics' }
local statsHeights = { exp = 14, loot = 14, kills = 14 }
local statsDynamic = { loot = { 'lootedItems', 'suppliesUsed' }, kills = { 'creatures' } }

local function openMiniWindow(win)
    if not win:getParent() then
        local panel = modules.game_interface.findContentPanelAvailable(win, win:getMinimumHeight())
        if not panel then return end
        panel:addChild(win)
    end
    win:open()
end

function toggleStats(kind)
    local win = statsWindows[kind]
    if not win then return end
    if win:isVisible() and win:getParent() then
        win:close()
    else
        openMiniWindow(win)
    end
end

function onStatsOpen(kind)
    if not S then return end
    if kind == 'exp' then refreshExp()
    elseif kind == 'loot' then refreshLoot()
    else refreshKills() end
end

function onStatsClose(kind) end

function toggle()
    if not window then return end
    if window:isVisible() and window:getParent() then
        window:close()
    else
        openMiniWindow(window)
    end
end

function onMiniWindowOpen() refreshSessionRow() end
function onMiniWindowClose() end

-- Jogo ------------------------------------------------------------------------------------
local function onGameStart()
    local key = (g_game.getCharacterName() or '') .. '@' .. (g_game.getWorldName and g_game.getWorldName() or '')
    if key ~= charKey or not S then
        charKey = key
        newSession()
    elseif S.started then
        S.runningSince = now()
    end
    local player = g_game.getLocalPlayer()
    lastExp = player and player:getExperience() or nil
    if lastExp == 0 then lastExp = nil end

    if window then window:setupOnStart() end
    for _, win in pairs(statsWindows) do win:setupOnStart() end
    if window then window:scheduleFitToContents() end
    for _, win in pairs(statsWindows) do win:scheduleFitToContents() end

    pricesLoading = nil
    requestPrices(0)
    if updateEvent then removeEvent(updateEvent) end
    updateEvent = cycleEvent(tick, 1000)
    refreshAll()
end

local function onGameEnd()
    if updateEvent then removeEvent(updateEvent); updateEvent = nil end
    if S and S.runningSince then
        S.accum = S.accum + (now() - S.runningSince)
        S.runningSince = nil
    end
    lastExp = nil
    if pageEvent then removeEvent(pageEvent); pageEvent = nil end
    pendingPage, pricesLoading = nil, nil
    closePrices()
end

function init()
    g_ui.importStyle('hunt74styles')
    loadUseValues()
    newSession()

    window = g_ui.loadUI('hunt74')
    window:setup()
    window:keepBasicButtons()
    window:setContentMinimumHeight(20)
    window:close(true)
    window:enableFitToContents(true) -- tamanho fixo, sem rolagem
    attachMenu(window)

    for kind, file in pairs(statsFiles) do
        local win = g_ui.loadUI(file)
        win:setup()
        win:getChildById('miniwindowTitle'):setText(tr(statsTitles[kind]))
        win:keepBasicButtons()
        win:setContentMinimumHeight(statsHeights[kind])
        win:close(true)
        -- Exp Statistics: tamanho fixo, sem rolagem. Loot/Kills: mínimo com todas
        -- as informações fixas à mostra (sem os itens/criaturas da sessão)
        win:enableFitToContents(kind == 'exp', statsDynamic[kind])
        attachMenu(win)
        statsWindows[kind] = win
    end

    ProtocolGame.registerOpcode(OPCODE, onHunt)
    connect(LocalPlayer, { onExperienceChange = onExperienceChange })
    connect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    if g_game.isOnline() then onGameStart() end
end

function terminate()
    ProtocolGame.unregisterOpcode(OPCODE)
    disconnect(LocalPlayer, { onExperienceChange = onExperienceChange })
    disconnect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd })
    onGameEnd()
    for _, win in pairs(statsWindows) do win:destroy() end
    statsWindows = {}
    if pricesWindow then pricesWindow:destroy(); pricesWindow = nil end
    if window then window:destroy(); window = nil end
end
