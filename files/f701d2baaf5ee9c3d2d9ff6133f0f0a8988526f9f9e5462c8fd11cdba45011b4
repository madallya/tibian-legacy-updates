    wsadWalking = false,            -- WASD so quando o jogador liga em Options
    walkFirstStepDelay = 200,
    walkDirChangeDelay = 0,
    camsRecording = true,
    screenshotOnDeath = false,
    screenshotOnLevelUp = false,
    screenshotOnMagicLevel = false,
    screenshotOnSkill = false,
    -- opções do Miracle que o OTClient não tinha (features74.lua)
    smoothWalking = false,
    lockCorpses = false,
    liveCam = false,
    displayPlayerHealth = true,
    creatureIcons = true,
    corpseShader = true,
    leftMinimapPanel = false,
    rightMinimapPanel = false,
    containerPanel = 1,
    ownDamageMessages = false,
    openChatOnPrivate = false,
    displaySelfMessages = true,
    displayPlayersMessages = true,
}

function getCustom(key)
    local default = customDefaults[key]
    local settingKey = 'classic74_' .. key
    if not g_settings.exists(settingKey) then return default end
    if type(default) == 'boolean' then return g_settings.getBoolean(settingKey) end
    if type(default) == 'number' then return g_settings.getNumber(settingKey) end
    return g_settings.get(settingKey)
end

local customActions = {
    walkFirstStepDelay = function(value)
        local root = modules.game_interface and modules.game_interface.getRootPanel and modules.game_interface.getRootPanel()
        if root then root:setAutoRepeatDelay(value) end
    end,
    wsadWalking = function(value)
        if modules.client_classic74 and modules.client_classic74.updateChatToggle then
            modules.client_classic74.updateChatToggle()
        end
    end,
    smoothWalking = function() applySmoothWalking() end,
    liveCam = function()
        if modules.game_livecam74 and modules.game_livecam74.sendSetting then modules.game_livecam74.sendSetting() end
    end,
    displayPlayerHealth = function() applyCreatureDrawing() end,
    creatureIcons = function() applyCreatureDrawing() end,
    corpseShader = function() applyCorpseShader() end,
    containerPanel = function() applyContainerPanel() end,
    -- só um painel horizontal de minimapa por vez
    leftMinimapPanel = function(value)
        if value and getCustom('rightMinimapPanel') then setCustom('rightMinimapPanel', false); refreshValues() end
        applyMinimapPanels(value)
    end,
    rightMinimapPanel = function(value)
        if value and getCustom('leftMinimapPanel') then setCustom('leftMinimapPanel', false); refreshValues() end
        applyMinimapPanels(value)
    end,
}

function setCustom(key, value)
    g_settings.set('classic74_' .. key, value)
    if customActions[key] then customActions[key](value) end
end

