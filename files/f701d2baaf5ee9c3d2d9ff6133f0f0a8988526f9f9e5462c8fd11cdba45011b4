-- Montagem ----------------------------------------------------------------------
local function getValue(item)
    local key = item.check or item.slider or item.combo
    if item.get then return item.get() end
    if item.custom then return getCustom(key) end
    return opt(key)
end

local function setValue(item, value)
    local key = item.check or item.slider or item.combo
    if item.set then return item.set(value) end
    if item.custom then return setCustom(key, value) end
    setOpt(key, value)
    if item.also then setOpt(item.also, value) end
end

local function buildPanel(tab)
    local panel = g_ui.createWidget('Panel')
    panel:setId(tab.name:lower() .. 'Panel')
    local first = true
    for _, item in ipairs(tab.items) do
        local widget
        if item.check then
            widget = g_ui.createWidget('Options74CheckBox', panel)
            widget:setText(tr(item.text))
            widget:setChecked(getValue(item) and true or false)
            widget.onCheckChange = function(self, checked) setValue(item, checked) end
            widgetsByKey[item.check] = { widget = widget, item = item }
        elseif item.slider then
            local label = g_ui.createWidget('Options74Label', panel)
            if first then label:addAnchor(AnchorTop, 'parent', AnchorTop); label:setMarginTop(0) end
            local bar = g_ui.createWidget('Options74ScrollBar', panel)
            bar:setMinimum(item.min)
            bar:setMaximum(item.max)
            local function updateText(value)
                local shown = item.format and item.format(value) or value
                label:setText(tr(item.text, shown))
            end
            local value = tonumber(getValue(item)) or item.min
            bar:setValue(value)
            updateText(value)
            bar.onValueChange = function(self, v)
                updateText(v)
                setValue(item, v)
            end
            widget = bar
            widgetsByKey[item.slider] = { widget = bar, item = item, label = label, updateText = updateText }
        elseif item.combo then
            local label = g_ui.createWidget('Options74Label', panel)
            label:setText(tr(item.text))
            local combo = g_ui.createWidget('Options74ComboBox', panel)
            for i, o in ipairs(item.options) do combo:addOption(tr(o.text), o.value or i) end
            -- setCurrentIndex dispara onOptionChange; ao só mostrar o valor salvo
            -- não pode regravar a opção (ex.: voltaria a coluna dos containers)
            local refreshing = false
            local function selectValue(value)
                refreshing = true
                local index = 1
                for i, o in ipairs(item.options) do
                    if (o.value or i) == value then index = i; break end
                end
                combo:setCurrentIndex(index)
                refreshing = false
            end
            selectValue(tonumber(getValue(item)))
            combo:setTextAlign(AlignLeft)
            combo.onOptionChange = function(self, text, data)
                if not refreshing then setValue(item, data) end
            end
            widget = combo
            widgetsByKey[item.combo] = { widget = combo, item = item, selectValue = selectValue }
        elseif item.button then
            widget = g_ui.createWidget('Options74Button', panel)
            widget:setText(tr(item.button))
            widget.onClick = item.action
            if first then widget:addAnchor(AnchorTop, 'parent', AnchorTop); widget:setMarginTop(0) end
        elseif item.separator then
            widget = g_ui.createWidget('Options74Separator', panel)
        elseif item.label then
            widget = g_ui.createWidget('Options74Label', panel)
            widget:setTextWrap(false)
            widget:setTextAutoResize(true)
            local text = type(item.label) == 'function' and item.label() or tr(item.label)
            widget:setText(text)
            if item.id then widget:setId(item.id) end
            if first then widget:addAnchor(AnchorTop, 'parent', AnchorTop); widget:setMarginTop(0) else widget:setMarginTop(6) end
        end
        first = false
    end
    return panel
end

function refreshValues()
    for key, entry in pairs(widgetsByKey) do
        local value = getValue(entry.item)
        if entry.item.check then
            entry.widget:setChecked(value and true or false)
        elseif entry.item.slider then
            value = tonumber(value) or entry.item.min
            entry.widget:setValue(value)
            entry.updateText(value)
        elseif entry.item.combo and entry.selectValue then
            entry.selectValue(tonumber(value))
        end
    end
end

-- Mostrar/esconder ----------------------------------------------------------------
function show()
    if not window then return end
    refreshValues()
    window:show()
    window:raise()
    window:focus()
end

function hide()
    if not window then return end
    g_settings.save()
    window:hide()
end

function toggle()
    if window and window:isVisible() then hide() else show() end
end

-- O botão de opções do topo e quem chama modules.client_options.toggle/show
-- passam a abrir esta janela.
local originals

local function takeOverClientOptions()
    local co = modules.client_options
    if not co then return end
    originals = originals or { toggle = co.toggle, show = co.show, hide = co.hide }
    co.toggle = toggle
    co.show = show
    co.hide = hide
    local topMenu = modules.client_topmenu and modules.client_topmenu.getTopMenu and modules.client_topmenu.getTopMenu()
    local button = topMenu and topMenu:recursiveGetChildById('optionsButton')
    if button then
        button.onMouseRelease = function(widget, mousePos, mouseButton)
            if widget:containsPoint(mousePos) and mouseButton == MouseLeftButton then
                toggle()
                return true
            end
        end
    end
end

-- Screenshots ------------------------------------------------------------------
-- Cada opcao funciona sozinha (nao tem mais a chave geral "Auto screenshots").
-- O 7.4 nao tem os eventos do servidor: vem das mensagens (level, magic level,
-- skills) e do "You are dead." (o protocolo 7.4 nao tem o pacote de morte).
function takeScreenshot(reason, now)
    if not g_game.isOnline() then return end
    local player = g_game.getLocalPlayer()
    local name = player and player:getName() or 'player'
    name = name:gsub('[^%w%-_ ]', '')
    local fileName = string.format('%s_%s_%s.png', name, reason or 'manual', os.date('%Y-%m-%d_%H-%M-%S'))
    local function shoot()
        if g_app.doScreenshotTo and g_app.getScreenshotsDir then
            local dir = g_app.getScreenshotsDir()
            local sep = dir:find('\\', 1, true) and '\\' or '/'
            g_app.doScreenshotTo(dir .. sep .. fileName)
        else
            if not g_resources.directoryExists('/' .. screenshotsDir) then g_resources.makeDir(screenshotsDir) end
            g_app.doScreenshot('/' .. screenshotsDir .. '/' .. fileName)
        end
        if modules.game_textmessage and modules.game_textmessage.displayStatusMessage then
            modules.game_textmessage.displayStatusMessage(tr('Screenshot saved: %s', fileName))
        end
    end
    -- morte: na hora, antes da janela de morte aparecer por cima
    if now then shoot() else scheduleEvent(shoot, 100) end
end

local function onTextMessage(mode, text)
    if type(text) ~= 'string' then return end
    if text:find('^You are dead%.') then
        if getCustom('screenshotOnDeath') then takeScreenshot('death', true) end
    elseif text:find('^You advanced from Level') then
        if getCustom('screenshotOnLevelUp') then takeScreenshot('level') end
    elseif text:find('^You advanced to magic level') then
        if getCustom('screenshotOnMagicLevel') then takeScreenshot('magiclevel') end
    elseif text:find('^You advanced in ') then
        if getCustom('screenshotOnSkill') then takeScreenshot('skill') end
    end
end

local function onGameStart()
    customActions.walkFirstStepDelay(getCustom('walkFirstStepDelay'))
end

function init()
    window = g_ui.displayUI('options74')
    window:hide()
    tabBar = window:getChildById('optionsTabBar')
    tabBar:setContentWidget(window:getChildById('optionsTabContent'))
    local tabScroll = tabBar:getChildById('scrollBar')
    if tabScroll then tabScroll:setWidth(0); tabScroll:hide() end
    for _, tab in ipairs(tabs) do
        local panel = buildPanel(tab)
        panels[tab.name] = panel
        local button = tabBar:addTab(tr(tab.name), panel, tab.icon)
        if button then
            button:setHeight(47)
            button:setMarginTop(#tabBar:getTabs() == 1 and 0 or 10)
        end
    end
    scheduleEvent(takeOverClientOptions, 300)
    initFeatures()
    applyOptimizationLevel()
    connect(g_game, { onTextMessage = onTextMessage, onGameStart = onGameStart })
    Keybind.new('Misc.', 'Take Screenshot', 'Ctrl+Shift+S', '')
    Keybind.bind('Misc.', 'Take Screenshot', {
        { type = KEY_DOWN, callback = function() takeScreenshot('manual') end }
    })
    if g_game.isOnline() then onGameStart() end
end

function terminate()
    terminateFeatures()
    disconnect(g_game, { onTextMessage = onTextMessage, onGameStart = onGameStart })
    Keybind.delete('Misc.', 'Take Screenshot')
    local co = modules.client_options
    if co and originals then
        co.toggle, co.show, co.hide = originals.toggle, originals.show, originals.hide
        originals = nil
    end
    if window then window:destroy(); window = nil end
end
