-- Screenshots em %APPDATA%\<nome do jogo>\screenshots (Telmora), fora da pasta de
-- configuracoes (g_app.getScreenshotsDir / doScreenshotTo no cliente). Cliente antigo
-- sem essas funcoes: pasta screenshots das configuracoes, como antes.
local screenshotsDir = 'screenshots'

local function screenshotsFolder()
    if g_app.getScreenshotsDir then return g_app.getScreenshotsDir() end
    if not g_resources.directoryExists('/' .. screenshotsDir) then g_resources.makeDir(screenshotsDir) end
    return g_resources.getWriteDir() .. screenshotsDir
end

local function opt(key)
    return modules.client_options.getOption(key)
end

local function setOpt(key, value)
    modules.client_options.setOption(key, value)
end

