local function gpuText()
    return string.format('GPU: %s\nVersion: %s', g_graphics.getRenderer(), g_graphics.getVersion())
end

-- Niveis de otimizacao (como no Miracle). "Otimizar" junta efeitos no mesmo
-- tile e encurta a espera entre eles; o limite de FPS diz quando isso liga.
-- fps = liga abaixo desses FPS | force = sempre | async = texturas em segundo plano
local optimizationLevels = {
    { text = 'Automatic', value = 1, optimize = true, fps = 58, force = false, async = false },
    { text = 'None', value = 2, optimize = false, fps = 58, force = false, async = false },
    { text = 'Low', value = 3, optimize = true, fps = 30, force = false, async = false },
    { text = 'Medium', value = 4, optimize = true, fps = 45, force = false, async = true },
    { text = 'High', value = 5, optimize = true, fps = 1000, force = false, async = true },
    { text = 'Maximum', value = 6, optimize = true, fps = 1000, force = true, async = true },
}

local function currentOptimizationIndex()
    local saved = tonumber(g_settings.getNumber('classic74_optimizationLevel')) or 0
    if optimizationLevels[saved] then return saved end
    -- configuracao antiga (so optimizeFps/forceEffectOptimization)
    if not opt('optimizeFps') then return 2 end
    if opt('forceEffectOptimization') then return 6 end
    return 1
end

function applyOptimizationLevel(index)
    local level = optimizationLevels[index or currentOptimizationIndex()]
    if not level then return end
    setOpt('optimizeFps', level.optimize)
    setOpt('forceEffectOptimization', level.force)
    if g_app.setOptimizeFpsThreshold then g_app.setOptimizeFpsThreshold(level.fps) end
    if g_app.setLoadingAsyncTexture and not g_app.isEncrypted() then
        g_app.setLoadingAsyncTexture(level.async)
    end
end

local function setOptimizationIndex(index)
    if not optimizationLevels[index] then return end
    g_settings.set('classic74_optimizationLevel', index)
    applyOptimizationLevel(index)
end

