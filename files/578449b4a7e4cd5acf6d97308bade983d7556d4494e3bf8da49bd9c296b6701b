-- ------------------------------------------------------------------ plaquinha de loja
local SHOP_ICON = '/game_playershop74/images/shop_stall'

local function applyMark(id)
    local mark = marks[id]
    local creature = g_map.getCreatureById(id)
    if not creature then return end
    local open = mark and mark.open
    local ok, err = pcall(function()
        -- ícone de loja no lugar da skull (cliente com o setShopIconTexture)
        if creature.setShopIconTexture then creature:setShopIconTexture(open and SHOP_ICON or '') end
        -- nome e barra de vida em rosa enquanto a loja está aberta, como no Miracle
        if creature.setInformationColorOverride then
            creature:setInformationColorOverride(open and SHOP_NAME_COLOR or '#00000000')
        end
        creature:detachWidgetById('playerShopSign')
        if not open then return end
        local sign = g_ui.createWidget('PlayerShop74Sign')
        local label = sign:getChildById('text')
        -- sem descrição: "<nome>'s Shop", como se fosse o nome da loja
        label:setText(mark.description ~= '' and mark.description or tr("%s's Shop", creature:getName()))
        -- texto comprido quebra em linhas (no máximo SIGN_TEXT_W de largura) e a
        -- tabuleta cresce para cima: a base fica sempre logo acima do nome
        local textW = label:getTextSize().width
        if textW > SIGN_TEXT_W then
            label:setTextAutoResize(false)
            label:setTextAlign(AlignCenter)
            label:setWidth(SIGN_TEXT_W)
            label:setTextWrap(true)
            label:setHeight(label:getTextSize().height)
            textW = SIGN_TEXT_W
        end
        local width = textW + 16
        local height = math.max(20, label:getHeight() + 8)
        sign:setSize({ width = width, height = height })
        -- o ponto de fixação é o meio de cima do personagem: centraliza e sobe acima do nome
        sign:setMarginLeft(-math.floor(width / 2))
        sign:setMarginTop(-(SIGN_BASE + height))
        creature:attachWidget(sign)
        -- 10/11: logo depois do login o mapa ainda não foi desenhado e o attachWidget prende a
        -- placa sem pai (g_client ainda sem o widget do mapa): ela existia mas não aparecia.
        if not sign:getParent() and modules.game_interface then
            local mapPanel = modules.game_interface.getMapPanel()
            if mapPanel then sign:setParent(mapPanel) end
        end
    end)
    if not ok then g_logger.warning('playershop74: plaquinha: ' .. tostring(err)) end
end

local ownTicks = 0

-- 10/11: antes, o id saía de "pending" e ganhava "asked" ANTES de mandar. Se o pedido não
-- saía (cliente ainda entrando no jogo) ou se perdia (limite de pedidos do servidor), a
-- criatura só era perguntada de novo quando saía e voltava para a tela: a loja demorava a
-- aparecer depois do login. Agora só tira da fila o que foi mandado, pergunta de novo o que
-- ficou sem resposta e manda logo (sem esperar o ciclo de 1 s).
local function flushMarks()
    markFlushEvent = nil
    if not g_game.isOnline() then return end
    local now, nowMs = os.time(), g_clock.millis()
    -- sem resposta depois de MARK_RETRY_MS: volta para a fila (se a criatura ainda está no mapa)
    for id, mark in pairs(marks) do
        if not mark.answered and mark.askedMs and nowMs - mark.askedMs >= MARK_RETRY_MS then
            mark.askedMs = nil
            if g_map.getCreatureById(id) then pending[id] = true end
        end
    end
    local ids = {}
    for id, _ in pairs(pending) do
        local mark = marks[id]
        if not mark or not mark.answered or now - (mark.asked or 0) >= MARK_ASK_EVERY then
            if not (mark and mark.askedMs) then   -- já perguntado e esperando: não repete
                ids[#ids + 1] = id
                if #ids >= MARK_BATCH then break end
            end
        else
            pending[id] = nil
        end
    end
    if #ids == 0 then return end
    if nowMs - markLastSend < MARK_GAP_MS then
        -- mandou há pouco: o próximo pedido sai assim que der
        if not markFlushEvent then markFlushEvent = scheduleEvent(flushMarks, MARK_GAP_MS - (nowMs - markLastSend)) end
        return
    end
    local sent = send(function(msg)
        msg:addU8(15); msg:addU8(#ids)
        for _, id in ipairs(ids) do msg:addU32(id) end
    end)
    if not sent then return end   -- fica na fila para o próximo ciclo
    markLastSend = nowMs
    for _, id in ipairs(ids) do
        pending[id] = nil
        local mark = marks[id] or { open = false, description = '' }
        mark.asked = now
        mark.askedMs = nowMs
        mark.answered = false
        marks[id] = mark
    end
end

local function scheduleFlush()
    if not markFlushEvent then markFlushEvent = scheduleEvent(flushMarks, MARK_FLUSH_MS) end
end

local function askMarks()
    -- com a janela da loja à vista, atualiza o tempo de loja uma vez por minuto
    ownTicks = ownTicks + 1
    if ownTicks >= 60 then
        ownTicks = 0
        if ownWindow and ownWindow:isVisible() and own.state == STATE_OPEN then
            send(function(msg) msg:addU8(1); msg:addU8(OWN_VERSION) end)
        end
    end
    flushMarks()
end

local function onCreatureAppear(creature)
    if not creature or not creature:isPlayer() or creature:isLocalPlayer() then return end
    local id = creature:getId()
    -- mostra logo o que já se sabe e pergunta de novo (a loja pode ter fechado fora da tela)
    if marks[id] and marks[id].open then applyMark(id) end
    pending[id] = true
    scheduleFlush()
end

function isShop(creature)
    if not creature or not creature:isPlayer() then return false end
    local mark = marks[creature:getId()]
    return mark ~= nil and mark.open == true
end

-- ------------------------------------------------------------------ servidor
local function onPlayerShop(protocol, msg)
    local sub = msg:getU8()
    if sub == 1 then
        own.state = msg:getU8()
        own.right = msg:getU32()
        own.tax = msg:getU8()
        own.description = msg:getString()
        own.offers = {}
        for i = 1, msg:getU16() do
            local o = {}
            o.id = msg:getU32()
            o.item = msg:getU16()
            o.count = msg:getU8()
            o.name = msg:getString()
            o.price = msg:getU32()
            o.lot = msg:getU8() ~= 0
            o.lotItems = msg:getU16()
            own.offers[i] = o
        end
        if msg:getUnreadSize() >= 4 then ownBank = msg:getU32() end
        -- versão 3: quantidade de cada oferta (pilha inteira e quanto está à venda)
        if msg:getUnreadSize() >= 2 then
            for i = 1, msg:getU16() do
                local total, selling = msg:getU16(), msg:getU16()
                if own.offers[i] then own.offers[i].total, own.offers[i].selling = total, selling end
            end
        end
        refreshOwn()
    elseif sub == 2 then
        local s = { lines = {} }
        s.id = msg:getU32()
        s.owner = msg:getString()
        s.description = msg:getString()
        for i = 1, msg:getU16() do
            local l = {}
            l.key = msg:getU32()
            l.item = msg:getU16()
            l.count = msg:getU8()
            l.name = msg:getString()
            l.available = msg:getU32()
            l.price = msg:getU32()
            local flags = msg:getU8()
            l.lot = (flags % 2) == 1
            l.cumulative = (math.floor(flags / 2) % 2) == 1
            s.lines[i] = l
        end
        -- ouro do comprador: só quando o sub 10 foi com a versão (servidor novo)
        local gold = msg:getUnreadSize() >= 4 and msg:getU32() or nil
        if shop and shop.id == s.id and browseWindow and browseWindow:isVisible() then
            shop = s
            browseGold = gold
            if browseWindow:recursiveGetChildById('description'):getText() == tr('Loading...') then
                setDescription(s.description ~= '' and s.description or '')
            end
            refreshBrowse()
        end
    elseif sub == 3 then
        local action = msg:getU8()
        local ok = msg:getU8() ~= 0
        local text = msg:getString()
        if action >= 10 then
            if browseWindow and browseWindow:isVisible() then
                if action == 10 and not ok then
                    -- loja fechou / longe demais: a janela fica vazia com o aviso
                    if shop then shop.lines = {} end
                    browseSel = nil
                    refreshBrowse()
                    fillContent(nil)
                    setDescription(text)
                elseif text ~= '' then
                    closeBoxes()
                    infoBox = displayInfoBox(ok and tr('Shop') or tr('Sorry'), text)
                end
            end
        elseif ownWindow and ownWindow:isVisible() then
            -- erro: caixa; acerto: na descrição (ex.: "Your shop is open...")
            if not ok and text ~= '' then
                closeBoxes()
                infoBox = displayInfoBox(tr('Shop'), text)
            elseif text ~= '' then
                ownSetDescription(text)
            end
        elseif not ok and text ~= '' then
            closeBoxes()
            infoBox = displayInfoBox(tr('Shop'), text)
        end
    elseif sub == 4 then
        local id = msg:getU32()
        local key = msg:getU32()
        local items = {}
        for i = 1, msg:getU8() do
            local it = {}
            it.item = msg:getU16()
            it.count = msg:getU8()
            it.name = msg:getString()
            items[i] = it
        end
        local me = g_game.getLocalPlayer()
        if me and id == me:getId() then
            if ownWindow and ownWindow:isVisible() and key == ownSel then
                local grid = ownWindow:recursiveGetChildById('ownContent')
                grid:destroyChildren()
                for i, it in ipairs(items) do
                    local slot = g_ui.createWidget('PlayerShop74Slot', grid)
                    setSlot(slot, it.item, it.count, it.count)
                    onSlotClick(slot, function() if ownSel then ownAskLook(ownSel, i) end end)
                end
                ownWindow:getChildById('ownContentLabel'):setText(tr('Container items (%d)', #items))
            end
        elseif browseWindow and browseWindow:isVisible() and shop and shop.id == id and key == browseSel then
            fillContent(items)
        end
    elseif sub == 5 then
        local page = msg:getU16()
        local pages = msg:getU16()
        local rowsData = {}
        for i = 1, msg:getU8() do
            local e = {}
            e.time = msg:getU32()
            e.buyer = msg:getString()
            e.item = msg:getString()
            e.amount = msg:getU32()
            e.total = msg:getU32()
            e.tax = msg:getU32()
            e.net = msg:getU32()
            rowsData[i] = e
        end
        if listWindow and listMode == 'sales' then
            sales.page, sales.pages = page, math.max(1, pages)
            local rows = listWindow:recursiveGetChildById('rows')
            rows:destroyChildren()
            for _, e in ipairs(rowsData) do
                local row = g_ui.createWidget('PlayerShop74SaleRow', rows)
                row:getChildById('date'):setText(os.date('%Y-%m-%d %H:%M', e.time))
                row:getChildById('text'):setText(string.format('%s: %dx %s', e.buyer, e.amount, e.item))
                row:getChildById('net'):setText('+' .. formatGold(e.net) .. ' gp')
                row:setTooltip(tr('Sold for %s gold, fee %s gold.', formatGold(e.total), formatGold(e.tax)))
            end
            listWindow:getChildById('pageLabel'):setText(string.format('%d/%d', sales.page + 1, sales.pages))
            listWindow:getChildById('prevButton'):setEnabled(sales.page > 0)
            listWindow:getChildById('nextButton'):setEnabled(sales.page + 1 < sales.pages)
        end
    elseif sub == 19 then
        -- versão 4: moldura de atributos e tempo/cargas de cada casa (1 = própria loja,
        -- 2 = loja de outro jogador, pela chave da linha)
        local where, ownerId = msg:getU8(), msg:getU32()
        local list = {}
        for i = 1, msg:getU16() do
            list[msg:getU32()] = { attr = msg:getU8(), kind = msg:getU8(), value = msg:getU32() }
        end
        if where == 1 then
            ownExtras = list
            if ownWindow then
                for _, slot in ipairs(ownWindow:recursiveGetChildById('offers'):getChildren()) do
                    if slot.offer then applyExtras(slot, ownExtras[slot.offer.id]) end
                end
                if ownSel then applyExtras(ownWindow:recursiveGetChildById('ownPreview'), ownExtras[ownSel]) end
            end
        elseif where == 2 and shop and shop.id == ownerId then
            browseExtras = list
            if browseWindow then
                for _, slot in ipairs(browseWindow:recursiveGetChildById('items'):getChildren()) do
                    if slot.line then applyExtras(slot, browseExtras[slot.line.key]) end
                end
            end
        end
    elseif sub == 6 then
        for i = 1, msg:getU8() do
            local id = msg:getU32()
            local open = msg:getU8() ~= 0
            local description = msg:getString()
            local old = marks[id]
            marks[id] = { open = open, description = description, asked = old and old.asked or os.time(), answered = true }
            applyMark(id)
            if not open and shop and shop.id == id and browseWindow and browseWindow:isVisible() then
                setDescription(tr('This shop is closed.'))
            end
        end
    end
end

-- ------------------------------------------------------------------ menu de contexto
local function isMainBackpackItem(thing)
    if not thing or not thing:isItem() then return false end
    local pos = thing:getPosition()
    -- dentro de um container aberto (64..79); o servidor confere se é a mochila principal
    return pos ~= nil and pos.x == 65535 and pos.y >= 64
end

local function addHooks()
    local gi = modules.game_interface
    if not gi or not gi.addMenuHook then return end
    gi.addMenuHook('playershop74', tr('Open Shop'),
        function() showOwn() end,
        function(menuPosition, lookThing, useThing, creatureThing)
            return creatureThing ~= nil and creatureThing:isLocalPlayer()
        end)
    -- a loja dos outros abre pelo "Open Shop" que o game_interface põe logo depois do Follow
    gi.addMenuHook('playershop74', tr('Add to shop'),
        function(menuPosition, lookThing, useThing, creatureThing) addToShop(useThing or lookThing) end,
        function(menuPosition, lookThing, useThing, creatureThing)
            return creatureThing == nil and own.right > 0 and own.state ~= STATE_OPEN
                and isMainBackpackItem(useThing or lookThing)
        end)
end

local function removeHooks()
    local gi = modules.game_interface
    if gi and gi.removeMenuHook then gi.removeMenuHook('playershop74') end
end

-- ------------------------------------------------------------------ jogo
local function onGameStart()
    -- (marks/pending já foram limpos no onGameEnd; limpar aqui perdia as criaturas que
    -- aparecem enquanto o jogo começa)
    own = { state = STATE_NONE, right = 0, tax = 0, description = '', offers = {} }
    -- pede o estado: diz se o personagem tem direito de loja (menu "Add to shop") e,
    -- quando o dono volta para o personagem que ficou vendendo, traz a loja pausada
    -- (11/11: 300 ms; o primeiro 0xEF também faz o servidor mandar as marcas das lojas à vista)
    -- 11/11 (queda da 121): manda SEMPRE a versão. Sem ela, depois de um relog o servidor
    -- respondia no formato antigo (sem saldo e quantidades) e a leitura "se ainda houver
    -- bytes" pegava a mensagem seguinte do mesmo pacote: leitura além do fim e queda
    scheduleEvent(function() send(function(msg) msg:addU8(1); msg:addU8(OWN_VERSION) end) end, 300)
end

local function onGameEnd()
    closeBoxes()
    hideList()
    hideBrowse()
    hideOwn()
    marks, pending = {}, {}
end

function init()
    ownWindow = g_ui.displayUI('playershop74')
    ownWindow:hide()
    browseWindow = g_ui.displayUI('playershopbrowse74')
    browseWindow:hide()
    listWindow = g_ui.displayUI('playershoplist74')
    listWindow:hide()
    priceWindow = g_ui.displayUI('playershopprice74')
    priceWindow:hide()
    descWindow = g_ui.displayUI('playershopdesc74')
    descWindow:hide()

    -- arrastar um item para a janela da loja = "Add to shop"
    ownWindow.onDrop = function(self, widget, mousePos)
        if not widget or not widget.currentDragThing then return false end
        addToShop(widget.currentDragThing)
        return true
    end
    browseWindow:recursiveGetChildById('amountScroll').onValueChange = function() updateInfo() end
    local ownPrice = ownWindow:recursiveGetChildById('ownPrice')
    ownPrice.onKeyPress = function(self, keyCode)
        if keyCode == KeyEnter or keyCode == KeyReturn then ownCommitPrice(); return true end
        return false
    end
    ownPrice.onFocusChange = function(self, focused) if not focused then ownCommitPrice() end end
    ownWindow:recursiveGetChildById('ownAmountScroll').onValueChange = function(self, value) ownAmountChanged(value) end
    browseWindow:getChildById('search').onTextChange = function() refreshBrowse() end

    ProtocolGame.registerOpcode(OPCODE, onPlayerShop)
    connect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd, onTextMessage = onLookText })
    connect(Creature, { onAppear = onCreatureAppear })
    addHooks()
    markEvent = cycleEvent(askMarks, 1000)
    if g_game.isOnline() then onGameStart() end
end

function terminate()
    if markEvent then removeEvent(markEvent); markEvent = nil end
    if markFlushEvent then removeEvent(markFlushEvent); markFlushEvent = nil end
    removeHooks()
    disconnect(Creature, { onAppear = onCreatureAppear })
    disconnect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd, onTextMessage = onLookText })
    ProtocolGame.unregisterOpcode(OPCODE)
    closeBoxes()
    for _, w in ipairs({ descWindow, priceWindow, listWindow, browseWindow, ownWindow }) do
        if w then w:destroy() end
    end
    descWindow, priceWindow, listWindow, browseWindow, ownWindow = nil, nil, nil, nil, nil
end
