-- Watch Cams ------------------------------------------------------------------
-- O servidor responde ao pedido de lista com a conta 0 e senha vazia com os
-- jogadores que ligaram a cam (Options > Game). Cada um vem como um personagem;
-- entrar nele abre a cam ao vivo (o modo espectador fica no game_livecam74).
local watchLogin

function watchLiveCams(enterGame)
    if g_game.isOnline() then
        local errorBox = displayErrorBox(tr('Watch Cams'), tr('Cannot login while already in game.'))
        connect(errorBox, { onOk = EnterGame.show })
        return
    end

    local host = enterGame:getChildById('serverHostTextEdit'):getText()
    local port = tonumber(enterGame:getChildById('serverPortTextEdit'):getText()) or 7171
    local clientVersion = tonumber(enterGame:getChildById('clientComboBox'):getText()) or 740

    G.watchingCam = true
    -- login cifrado com email e senha vazios = lista das cams; o espectador
    -- entra no jogo com a conta 0
    G.account = ''
    G.gameAccount = '0'
    G.password = ''
    G.host = host
    G.port = port
    G.authenticatorToken = nil
    G.sessionKey = nil

    EnterGame.hide()
    if watchLogin then watchLogin:cancelLogin() end
    local protocol = ProtocolLogin.create()
    watchLogin = protocol
    local loadBox = displayCancelBox(tr('Please wait'), tr('Looking for live cams...'))
    connect(loadBox, {
        onCancel = function()
            loadBox = nil
            protocol:cancelLogin()
            watchLogin = nil
            G.watchingCam = false
            EnterGame.show()
        end
    })

    local function closeLoadBox()
        if loadBox then
            loadBox:destroy()
            loadBox = nil
        end
    end

    protocol.onLoginError = function(_, message)
        closeLoadBox()
        watchLogin = nil
        G.watchingCam = false
        local errorBox = displayErrorBox(tr('Watch Cams'), message)
        connect(errorBox, { onOk = EnterGame.show })
    end
    protocol.onMotd = function() end
    protocol.onSessionKey = function() end
    protocol.onUpdateNeeded = function() end
    protocol.onCharacterList = function(_, characters, account, otui)
        closeLoadBox()
        watchLogin = nil
        -- o jogo fica no mesmo endereço do login
        for _, character in pairs(characters) do
            character.worldIp = host
        end
        CharacterList.create(characters, account, otui)
        CharacterList.show()
    end

    g_game.setClientVersion(clientVersion)
    g_game.setProtocolVersion(g_game.getClientProtocolVersion(clientVersion))
    g_game.chooseRsa(host)
    protocol:login(host, port, '0', '', nil, false)
end

-- Lista de personagens ----------------------------------------------------------
-- O characterlist.lua do OTClient já tem o modo simples (nome + (mundo)); aqui só
-- deixamos a janela com o tamanho, as cores e o texto do Miracle.
local function styleCharacterList()
    local window = rootWidget:recursiveGetChildById('charactersWindow')
    if not window then return end
    window:setSize({ width = 346, height = 396 })
    local list = window:getChildById('characters')
    if list then
        list:setBackgroundColor('#565656')
        for _, row in ipairs(list:getChildren()) do
            row.rowColor = '#56565600'
            local name = row:getChildById('name')
            local world = row:getChildById('worldName')
            if name then name:setFont('verdana-11px-antialised') end
            if world then
                world:setFont('verdana-11px-antialised')
                world:setTextWrap(false)
                world:setText(world:getText())
                world:resizeToText()
            end
            row:setHeight(14)
            row.updateOnStates = function(self)
                local focused = self:isFocused()
                for _, child in ipairs(self:getChildren()) do child:setOn(focused) end
                self:setBackgroundColor(focused and '#6d6d6d' or '#56565600')
                self:setBorderWidth(0)
            end
            row:updateOnStates()
        end
    end
    local autoReconnect = window:getChildById('autoReconnect')
    if autoReconnect then autoReconnect:hide() end
    -- "Account Status:" à esquerda e o status à direita, na mesma linha
    local caption = window:getChildById('accountStatusCaption')
    local status = window:getChildById('accountStatusLabel')
    local separator = window:getChildById('separator')
    if caption and status and separator then
        caption:breakAnchors()
        caption:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        caption:addAnchor(AnchorBottom, 'separator', AnchorTop)
        caption:setMarginBottom(6)
        caption:setTextAutoResize(true)
        status:breakAnchors()
        status:addAnchor(AnchorRight, 'parent', AnchorRight)
        status:addAnchor(AnchorBottom, 'separator', AnchorTop)
        status:setMarginBottom(6)
        status:setOn(false)
        separator:setMarginBottom(8)
        local account = G.characterAccount
        if G.watchingCam then
            -- lista do "Watch Cams": cada linha é um jogador com a cam ligada
            window:setText(tr('Live Cams'))
            caption:setText(tr('Live cams') .. ':')
            status:setText(tostring(#(G.characters or {})))
        elseif account then
            window:setText(tr('Character List'))
            caption:setText(tr('Account Status') .. ':')
            local days = tonumber(account.premDays) or 0
            if account.subStatus == SubscriptionStatus.Premium and days > 0 and days ~= 65535 then
                status:setText(tr('Premium Account (%d) days left', days))
            elseif account.subStatus == SubscriptionStatus.Premium then
                status:setText(tr('Premium Account'))
            else
                status:setText(tr('Free Account'))
            end
        end
        local list2 = window:getChildById('characters')
        local scroll = window:getChildById('characterListScrollBar')
        if list2 then list2:addAnchor(AnchorBottom, 'accountStatusCaption', AnchorTop); list2:setMarginBottom(8) end
        if scroll then scroll:addAnchor(AnchorBottom, 'accountStatusCaption', AnchorTop); scroll:setMarginBottom(8) end
    end
end

local function hookCharacterList()
    if not CharacterList or CharacterList.__classic74 then return end
    local originalCreate = CharacterList.create
    CharacterList.create = function(...)
        local result = originalCreate(...)
        styleCharacterList()
        return result
    end
    local originalRebuild = CharacterList.rebuildCharactersList
    CharacterList.rebuildCharactersList = function(...)
        local result = originalRebuild(...)
        styleCharacterList()
        return result
    end
    CharacterList.__classic74 = true
end

-- Contas favoritas -------------------------------------------------------------
local favoritesWindow
local favoriteAddWindow

-- Guardado em config.otml como { f1 = {account, password}, f2 = ... } (conta e senha criptografadas).
local function loadFavorites()
    local node = g_settings.getNode('classic74_favorites') or {}
    local keys = {}
    for key, entry in pairs(node) do
        local n = tonumber(tostring(key):match('^f(%d+)$'))
        if n and type(entry) == 'table' and entry.account then table.insert(keys, n) end
    end
    table.sort(keys)
    local result = {}
    for _, n in ipairs(keys) do table.insert(result, node['f' .. n]) end
    return result
end

local function saveFavorites(list)
    local node = {}
    for i, entry in ipairs(list) do
        node['f' .. i] = { account = entry.account, password = entry.password }
    end
    g_settings.setNode('classic74_favorites', node)
    g_settings.save()
end

local function refreshFavorites()
    if not favoritesWindow then return end
    local list = favoritesWindow:getChildById('accountList')
    list:destroyChildren()
    for index, entry in ipairs(loadFavorites()) do
        local label = g_ui.createWidget('FavoriteAccountLabel', list)
        label:setText(safeDecrypt(entry.account))
        label.favoriteIndex = index
    end
    local function updateButtons()
        local selected = list:getFocusedChild()
        favoritesWindow:getChildById('loginButton'):setEnabled(selected ~= nil)
        favoritesWindow:getChildById('removeButton'):setEnabled(selected ~= nil)
    end
    list.onChildFocusChange = updateButtons
    updateButtons()
end

function showFavorites()
    if g_game.isOnline() then return end
    if favoritesWindow then
        favoritesWindow:raise(); favoritesWindow:focus()
        return
    end
    favoritesWindow = g_ui.displayUI('favorites')
    favoritesWindow.onDestroy = function() favoritesWindow = nil end
    if EnterGame and EnterGame.hide then EnterGame.hide() end
    refreshFavorites()
    favoritesWindow:show(); favoritesWindow:raise(); favoritesWindow:focus()
end

local function showEnterGameIfIdle()
    local charList = CharacterList and CharacterList.isVisible and CharacterList.isVisible()
    if not g_game.isOnline() and not charList and EnterGame and EnterGame.show then EnterGame.show() end
end

function closeFavorites()
    if favoriteAddWindow then favoriteAddWindow:destroy(); favoriteAddWindow = nil end
    if favoritesWindow then favoritesWindow:destroy(); favoritesWindow = nil end
    showEnterGameIfIdle()
end

function toggleFavorites()
    if favoritesWindow then closeFavorites() else showFavorites() end
end

function addFavorite()
    if favoriteAddWindow then favoriteAddWindow:destroy() end
    favoriteAddWindow = g_ui.displayUI('favoriteadd')
    favoriteAddWindow.onDestroy = function() favoriteAddWindow = nil end
    local enterGame = rootWidget:recursiveGetChildById('enterGame')
    if enterGame then
        favoriteAddWindow:getChildById('account'):setText(enterGame:getChildById('accountNameTextEdit'):getText())
        favoriteAddWindow:getChildById('password'):setText(enterGame:getChildById('accountPasswordTextEdit'):getText())
    end
    favoriteAddWindow:getChildById('account'):focus()
end

function confirmAddFavorite()
    if not favoriteAddWindow then return end
    local account = favoriteAddWindow:getChildById('account'):getText()
    local password = favoriteAddWindow:getChildById('password'):getText()
    if #account == 0 then return end
    local list = loadFavorites()
    for i = #list, 1, -1 do
        if safeDecrypt(list[i].account) == account then table.remove(list, i) end
    end
    table.insert(list, { account = g_crypt.encrypt(account), password = g_crypt.encrypt(password) })
    saveFavorites(list)
    favoriteAddWindow:destroy()
    refreshFavorites()
end

local function selectedFavorite()
    if not favoritesWindow then return end
    local selected = favoritesWindow:getChildById('accountList'):getFocusedChild()
    if not selected then return end
    return loadFavorites()[selected.favoriteIndex], selected.favoriteIndex
end

function removeFavorite()
    local _, index = selectedFavorite()
    if not index then return end
    local list = loadFavorites()
    table.remove(list, index)
    saveFavorites(list)
    refreshFavorites()
end

function loginFavorite()
    local entry = selectedFavorite()
    if not entry then return end
    local enterGame = rootWidget:recursiveGetChildById('enterGame')
    if not enterGame then return end
    enterGame:getChildById('accountNameTextEdit'):setText(safeDecrypt(entry.account))
    enterGame:getChildById('accountPasswordTextEdit'):setText(safeDecrypt(entry.password))
    favoritesWindow:destroy()
    EnterGame.show() -- o doLogin esconde de novo; se não logar, a janela fica na tela
    EnterGame.doLogin()
end

-- Cams locais -----------------------------------------------------------------
-- O OTClient toca arquivos da pasta records\ (ao lado do executável) com
-- g_game.playRecord. O servidor grava em cams/<id do personagem>/.
local camWindow
local recordsMounted = false
local playingCam = false

local function listCams()
    if not recordsMounted then
        recordsMounted = g_resources.addSearchPath(g_resources.getWorkDir() .. 'records', false) or false
    end
    local cams = {}
    for _, file in ipairs(g_resources.listDirectoryFiles('/', false, false) or {}) do
        if file:lower():match('%.cam$') then table.insert(cams, file) end
    end
    table.sort(cams, function(a, b) return a > b end)
    return cams
end

function showCams()
    if camWindow then camWindow:destroy() end
    camWindow = g_ui.displayUI('camwindow')
    camWindow.onDestroy = function() camWindow = nil end
    if EnterGame and EnterGame.hide then EnterGame.hide() end
    local list = camWindow:getChildById('camList')
    local cams = listCams()
    if #cams == 0 then
        local label = g_ui.createWidget('CamListLabel', list)
        label:setText(tr('No recordings found.'))
        label:setEnabled(false)
    end
    for _, name in ipairs(cams) do
        local label = g_ui.createWidget('CamListLabel', list)
        label:setText(name)
        label.camFile = name
        label.onDoubleClick = function() playCam(name) end
    end
    camWindow:show(); camWindow:raise(); camWindow:focus()
end

function closeCams()
    if camWindow then camWindow:destroy(); camWindow = nil end
    showEnterGameIfIdle()
end

function openCamsFolder()
    g_platform.openDir(g_resources.getWorkDir() .. 'records')
end

function isPlayingCam()
    return playingCam
end

function playCam(file)
    g_game.setClientVersion(740)
    g_game.setProtocolVersion(g_game.getClientProtocolVersion(740))
    if camWindow then camWindow:destroy(); camWindow = nil end
    if EnterGame and EnterGame.hide then EnterGame.hide() end
    playingCam = true
    g_game.playRecord(file)
end

function playSelectedCam()
    if not camWindow then return end
    local selected = camWindow:getChildById('camList'):getFocusedChild()
    if selected and selected.camFile then playCam(selected.camFile) end
end

local function setupLoginScreen()
    local topMenu = getTopMenu()
    if topMenu and not g_game.isOnline() then topMenu:show() end
    setupTopMenu()
    setupEnterGame()
    hookCharacterList()
    fitBackground()
end


