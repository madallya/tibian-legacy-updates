end

-- Tela de login ---------------------------------------------------------------

-- Fundo ocupando a tela toda (corta o que sobra, sem distorcer), preso no topo
-- para não cortar o logo da arte.
local function fitBackground()
    local bg = rootWidget and rootWidget:recursiveGetChildById('background')
    if not bg then return end
    local tw, th = bg:getImageTextureWidth(), bg:getImageTextureHeight()
    local size = bg:getSize()
    if tw <= 0 or th <= 0 or size.width <= 0 or size.height <= 0 then return end
    local scale = math.max(size.width / tw, size.height / th)
    local cw = math.floor(size.width / scale)
    local ch = math.floor(size.height / scale)
    bg:setImageClip({ x = math.floor((tw - cw) / 2), y = 0, width = cw, height = ch })
    bg:setImageRect({ x = 0, y = 0, width = size.width, height = size.height })
end

local function setupTopMenu()
    local topMenu = getTopMenu()
    if not topMenu then return end
    topMenu:setWidth(TOP_MENU_WIDTH)
    topMenu:setMarginTop(2)
    -- sem contador de jogadores, YouTube e streamers
    for _, id in ipairs({ 'topLeftOnlinePlayers', 'topLeftYoutube' }) do
        hideWidget(topMenu, id)
    end
    local discord = topMenu:recursiveGetChildById('topLeftDiscord')
    if discord then
        for _, child in ipairs(discord:getChildren()) do
            if child:getId() ~= 'discordIcon' then child:hide() end
        end
        discord:setWidth(36)
        local icon = discord:getChildById('discordIcon')
        if icon then
            icon:setSize({ width = 24, height = 27 })
            icon:setTooltip(tr('Discord'))
            icon.onClick = function()
                if DISCORD_URL ~= '' then g_platform.openUrl(DISCORD_URL) end
            end
        end
    end
    -- direita: Favorite Accounts, Options, Exit (sem botão de áudio)
    hideWidget(topMenu, 'audioButton')
    local exitButton = topMenu:recursiveGetChildById('logoutButton')
    if exitButton then
        exitButton:setTooltip(tr('Exit'))
        exitButton.onMouseRelease = function(widget, mousePos, mouseButton)
            if widget:containsPoint(mousePos) and mouseButton == MouseLeftButton then
                g_app.exit()
                return true
            end
        end
    end
    if not topMenu:recursiveGetChildById('favoritesButton') then
        modules.client_topmenu.addTopRightToggleButton('favoritesButton', tr('Favorite Accounts') .. ' (Ctrl+F)',
            '/images/topbuttons/favorites', toggleFavorites, true)
    end
end

