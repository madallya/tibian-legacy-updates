-- Partes do painel da direita (minimapa, vida/mana, botoes, equipamento e
-- Skills/Battle/VIP/Store): cada uma vai para qualquer coluna e em qualquer
-- ordem, arrastando pela borda. A posicao fica salva por personagem.
local bottomButtonsWindow
local LAYOUT_KEY = 'classic74_layout'

local function layoutParts()
    local parts = {}
    local mm = modules.game_minimap and modules.game_minimap.mapController and modules.game_minimap.mapController.ui
    local hm = modules.game_healthinfo and modules.game_healthinfo.healthManaController and modules.game_healthinfo.healthManaController.ui
    local inv = modules.game_inventory and modules.game_inventory.inventoryController and modules.game_inventory.inventoryController.ui
    for _, w in ipairs({ mm, hm, panelButtonsWindow, inv, bottomButtonsWindow }) do
        if w and not w:isDestroyed() then table.insert(parts, w) end
    end
    return parts
end

local function isColumn(widget)
    return widget and not widget:isDestroyed() and widget:getClassName() == 'UIMiniWindowContainer'
end

function saveLayout()
    local char = g_game.getCharacterName()
    if not char or char == '' then return end
    local node = g_settings.getNode(LAYOUT_KEY) or {}
    local entry = node[char] or {}
    for _, w in ipairs(layoutParts()) do
        local parent = w:getParent()
        if isColumn(parent) then
            entry[w:getId()] = { parent = parent:getId(), index = parent:getChildIndex(w) }
        end
    end
    node[char] = entry
    node['_last'] = entry
    g_settings.setNode(LAYOUT_KEY, node)
end

local function onPartDropped(widget)
    if modules.game_mainpanel and modules.game_mainpanel.reloadMainPanelSizes then
        modules.game_mainpanel.reloadMainPanelSizes()
    end
    -- fora do painel principal a parte guarda a propria altura
    if widget.panelHeight then
        local parent = widget:getParent()
        if isColumn(parent) and parent:getId() ~= 'gameMainRightPanel' and widget:getId() ~= 'maininventorypanel' then
            widget:setHeight(widget.panelHeight)
        end
    end
    saveLayout()
end

local function restoreLayout()
    local char = g_game.getCharacterName()
    local node = g_settings.getNode(LAYOUT_KEY) or {}
    local entry = node[char] or node['_last']
    local root = modules.game_interface.getRootPanel()
    local list = {}
    for _, w in ipairs(layoutParts()) do
        w.anyPanel = true
        w.moveOnlyToMain = false
        w:setPhantom(false)
        w.onDropped = onPartDropped
        local saved = entry and entry[w:getId()]
        if saved and root then
            local column = root:recursiveGetChildById(saved.parent)
            if isColumn(column) and column:isVisible() then
                table.insert(list, { widget = w, column = column, index = tonumber(saved.index) or 1 })
            end
        end
    end
    table.sort(list, function(a, b) return a.index < b.index end)
    for _, item in ipairs(list) do
        local w, column = item.widget, item.column
        local parent = w:getParent()
        if parent ~= column or column:getChildIndex(w) ~= item.index then
            if parent then parent:removeChild(w) end
            column:insertChild(math.min(item.index, column:getChildCount() + 1), w)
        end
        if column:getId() ~= 'gameMainRightPanel' and w.panelHeight and w:getId() ~= 'maininventorypanel' then
            w:setHeight(w.panelHeight)
        end
    end
    if modules.game_mainpanel and modules.game_mainpanel.reloadMainPanelSizes then
        modules.game_mainpanel.reloadMainPanelSizes()
    end
end

local function setupPanelButtons()
    local mainPanel = modules.game_interface and modules.game_interface.getMainRightPanel and modules.game_interface.getMainRightPanel()
    if not mainPanel then return end
    if not panelButtonsWindow then
        panelButtonsWindow = g_ui.loadUI('panelbuttons', mainPanel)
        local row = panelButtonsWindow:getChildById('buttons')
        for _, def in ipairs(panelButtonList) do
            local button = g_ui.createWidget('Classic74IconButton', row)
            button:setId(def.id)
            button:setImageSource(def.icon)
            button:setTooltip(tr(def.tip))
            button.onClick = def.action or function() notAvailable(def.tip) end
        end
    end
    -- primeira vez: botoes logo abaixo de vida/mana e Skills/Battle/VIP/Store
    -- logo abaixo do equipamento (depois vale a ordem salva)
    if not panelButtonsWindow.placed74 then
        panelButtonsWindow.placed74 = true
        local health = mainPanel:getChildById('mainhealthmanapanel')
        local index = health and mainPanel:getChildIndex(health) or 2
        mainPanel:moveChildToIndex(panelButtonsWindow, index + 1)
    end
    if not bottomButtonsWindow then
        bottomButtonsWindow = g_ui.loadUI('bottombuttons', mainPanel)
        local inventory = mainPanel:getChildById('maininventorypanel')
        if inventory then
            mainPanel:moveChildToIndex(bottomButtonsWindow, mainPanel:getChildIndex(inventory) + 1)
        end
    end
    restoreLayout()
    -- o painel de botões do Tibia 12 (store grande, ícones) sai; os botões
    -- ficam no inventário
    local options = mainPanel:getChildById('mainoptionspanel')
    if options then
        options:hide()
        if not options.__classic74 then
            options.__classic74 = true
            -- a visão estendida (Ctrl+.) mostra o painel de novo ao sair dela
            connect(options, { onVisibilityChange = function(widget, visible)
                if visible then scheduleEvent(function() widget:hide() end, 1) end
            end })
        end
    end
    if modules.game_mainpanel and modules.game_mainpanel.reloadMainPanelSizes then
        modules.game_mainpanel.reloadMainPanelSizes()
    end
end

-- Chat ----------------------------------------------------------------------------
-- Como no Miracle: abas Default e Server Log, caixinha à esquerda para andar com
-- ASDW (no lugar do botão "Chat On/Off"), sem o painel de leitura dividido.
local asdwBox

-- O cliente vem sem WASD: so com "Enable WSAD walking" ligado em Options a
-- caixinha aparece e o chat pode ser desligado para andar com WASD.
local function wsadEnabled()
    local key = 'classic74_wsadWalking'
    return g_settings.exists(key) and g_settings.getBoolean(key)
end

local function syncAsdwBox()
    local console = modules.game_console
    if not asdwBox or not console or not console.consoleToggleChat then return end
    local walking = console.consoleToggleChat.isChecked == true
    if asdwBox:isChecked() ~= walking then
        asdwBox.syncing = true
        asdwBox:setChecked(walking)
        asdwBox.syncing = false
    end
end

function updateChatToggle()
    local console = modules.game_console
    if not asdwBox or not console then return end
    local enabled = wsadEnabled()
    asdwBox:setVisible(enabled)
    -- com WASD ligado, o Enter alterna como no Tibia: Enter abre o chat para uma
    -- mensagem (Chat On*), Enter envia e volta a andar; Enter vazio tambem volta
    if modules.client_options and modules.client_options.getOption
            and modules.client_options.getOption('returnDisablesChat') ~= enabled then
        modules.client_options.setOption('returnDisablesChat', enabled)
    end
    -- opção desligada: volta para o modo chat
    if not enabled and console.consoleToggleChat and console.consoleToggleChat.isChecked == true then
        console.toggleChat()
    end
    syncAsdwBox()
end

local function setupConsole()
    local console = modules.game_console
    local panel = rootWidget:recursiveGetChildById('consolePanel')
    if not console or not panel then return end

    -- 7.4 não tem cooldown de grupo de magias: a faixa escondida do cooldown
    -- ficava com 10 px e empurrava o chat para baixo (sobrava fundo entre o
    -- mapa e as abas). Escondida = 0 px.
    local cooldown = modules.game_cooldown
    if cooldown and cooldown.setSpellGroupCooldownsVisible and not cooldown.__classic74 then
        local original = cooldown.setSpellGroupCooldownsVisible
        cooldown.setSpellGroupCooldownsVisible = function(visible)
            original(visible)
            if not visible and cooldown.cooldownWindow then cooldown.cooldownWindow:setHeight(0) end
        end
        cooldown.__classic74 = true
    end
    if cooldown and cooldown.cooldownWindow and not cooldown.cooldownWindow:isVisible() then
        cooldown.cooldownWindow:setHeight(0)
    end

    -- Default antes do Server Log
    local tabBar = panel:getChildById('consoleTabBar')
    local default = console.defaultTab
    if tabBar and default and tabBar.tabs then
        for i, tab in ipairs(tabBar.tabs) do
            if tab == default and i > 1 then tabBar:moveTab(default, -(i - 1)) end
        end
    end

    -- sem leitura dividida, exiva (não existe no 7.4) e botão Chat On/Off
    for _, id in ipairs({ 'readOnlyButton', 'readOnlyPanel', 'exivaOption', 'toggleChat' }) do
        local w = panel:getChildById(id)
        if w then w:hide(); w:setWidth(0) end
    end
    local content = panel:getChildById('consoleContentPanel')
    if content then
        content:removeAnchor(AnchorRight)
        content:addAnchor(AnchorRight, 'parent', AnchorRight)
        content:setMarginRight(4)
    end
    local ignore = panel:getChildById('ignoreButton')
    if ignore then
        ignore:removeAnchor(AnchorRight)
        ignore:addAnchor(AnchorRight, 'parent', AnchorRight)
        ignore:setMarginRight(5)
    end
    -- como no Miracle: [<] nas abas a esquerda; [>] [x] [limpar] [canais] [ignorar]
    -- a direita. As setas trocam de canal (em roda), sempre ligadas.
    local function consoleButton(id, row, tooltip, onClick)
        local button = panel:getChildById(id)
        if button then return button end
        button = g_ui.createWidget('UIButton', panel)
        button:setId(id)
        button:setSize({ width = 16, height = 16 })
        button:setImageSource('/images/ui/console_buttons74')
        button:setImageClip({ x = 0, y = row * 16, width = 16, height = 16 })
        button:setTooltip(tr(tooltip))
        button.onMousePress = function(self) self:setImageClip({ x = 16, y = row * 16, width = 16, height = 16 }) end
        button.onMouseRelease = function(self) self:setImageClip({ x = 0, y = row * 16, width = 16, height = 16 }) end
        button.onClick = onClick
        return button
    end
    local function switchTab(next)
        local bar = panel:getChildById('consoleTabBar')
        if not bar or not bar.tabs or #bar.tabs < 2 then return end
        local current = bar:getCurrentTab()
        local index = 1
        for i, tab in ipairs(bar.tabs) do if tab == current then index = i end end
        index = next and (index % #bar.tabs + 1) or ((index - 2) % #bar.tabs + 1)
        bar:selectTab(bar.tabs[index])
    end
    for _, id in ipairs({ 'prevChannelButton', 'nextChannelButton' }) do
        local w = panel:getChildById(id)
        if w then w:hide(); w:setWidth(0) end
    end
    local close = panel:getChildById('closeChannelButton')
    local channels = panel:getChildById('channelsButton')
    if close and channels then
        local clear = consoleButton('clearChannel74', 2, 'Clear messages', function()
            local bar = panel:getChildById('consoleTabBar')
            if bar and bar:getCurrentTab() then modules.game_console.clearChannel(bar) end
        end)
        clear:breakAnchors()
        clear:addAnchor(AnchorRight, 'channelsButton', AnchorLeft)
        clear:addAnchor(AnchorBottom, 'consoleContentPanel', AnchorTop)
        clear:setMarginRight(1)
        clear:setMarginBottom(5)
        close:removeAnchor(AnchorRight)
        close:addAnchor(AnchorRight, 'clearChannel74', AnchorLeft)
        local nextButton = consoleButton('nextChannel74', 0, 'Next channel', function() switchTab(true) end)
        nextButton:breakAnchors()
        nextButton:addAnchor(AnchorRight, 'closeChannelButton', AnchorLeft)
        nextButton:addAnchor(AnchorBottom, 'consoleContentPanel', AnchorTop)
        nextButton:setMarginRight(1)
        nextButton:setMarginBottom(5)
        local prevButton = consoleButton('prevChannel74', 1, 'Previous channel', function() switchTab(false) end)
        prevButton:breakAnchors()
        prevButton:addAnchor(AnchorTop, 'consoleTabBar', AnchorTop)
        prevButton:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        prevButton:setMarginTop(1)
        prevButton:setMarginLeft(20)
        if tabBar then
            tabBar:removeAnchor(AnchorRight)
            tabBar:addAnchor(AnchorRight, 'nextChannel74', AnchorLeft)
            tabBar:setMarginRight(4)
        end
    end

    local textEdit = panel:getChildById('consoleTextEdit')
    if textEdit then
        textEdit:removeAnchor(AnchorRight)
        textEdit:addAnchor(AnchorRight, 'parent', AnchorRight)
        textEdit:setMarginRight(4)
        textEdit:mergeStyle({ ['placeholder-color'] = 'alpha' }) -- sem "Type here to chat"
    end

    -- caixinha do modo ASDW
    if not asdwBox then
        asdwBox = g_ui.createWidget('CheckBox', panel)
        asdwBox:setId('asdwBox74')
        asdwBox:setTooltip(tr('Disable chat mode, allow to walk using ASDW'))
        asdwBox:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        asdwBox:addAnchor(AnchorTop, 'consoleTabBar', AnchorTop)
        asdwBox:setMarginTop(3)
        asdwBox:setMarginLeft(4)
        asdwBox.onCheckChange = function(self, checked)
            if self.syncing then return end
            local c = modules.game_console
            if c and c.consoleToggleChat and (c.consoleToggleChat.isChecked == true) ~= checked then
                c.toggleChat()
            end
        end
        if tabBar then tabBar:setMarginLeft(38) end
        -- o toggleChat do console também é chamado pelo Enter: mantém a caixinha certa
        if not console.__classic74 then
            local originalToggle = console.toggleChat
            console.__classic74Toggle = originalToggle
            console.toggleChat = function(...)
                -- WASD desligado em Options: nada (Esc, Enter, hotkey, botao
                -- do NPC) tira o chat; so volta para o chat se estava sem
                local c = modules.game_console
                if not wsadEnabled() and c.consoleToggleChat and c.consoleToggleChat.isChecked ~= true then
                    return
                end
                local result = originalToggle(...)
                syncAsdwBox()
                return result
            end
            console.__classic74 = true
        end
    end
    updateChatToggle()
end

-- FPS e ping no canto do mapa ------------------------------------------------------
local fpsLabel, pingLabel

local function setupFpsPing()
    local mapPanel = modules.game_interface and modules.game_interface.getMapPanel and modules.game_interface.getMapPanel()
    if not mapPanel then return end
    -- o indicador "Low lag (x ms)" / "x fps" do topmenu sai
    for _, id in ipairs({ 'ping', 'fps' }) do
        local w = mapPanel:recursiveGetChildById(id)
        local root = w and w:getParent() and w:getParent():getParent()
        if root and root ~= mapPanel then root:hide() end
    end
    if not fpsLabel then
        fpsLabel = g_ui.createWidget('Classic74MapInfoLabel', mapPanel)
        fpsLabel:setId('fps74')
        fpsLabel:addAnchor(AnchorTop, 'parent', AnchorTop)
        fpsLabel:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        pingLabel = g_ui.createWidget('Classic74MapInfoLabel', mapPanel)
        pingLabel:setId('ping74')
        pingLabel:addAnchor(AnchorTop, 'fps74', AnchorBottom)
        pingLabel:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        pingLabel:setMarginTop(0)
        pingLabel:setColor('#00ff00')
    end
    fpsLabel:setVisible(modules.client_options.getOption('showFps'))
    pingLabel:setVisible(false) -- só aparece quando chega a primeira resposta de ping
end

local function onFps(fps)
    if not fpsLabel then return end
    local show = g_game.isOnline() and modules.client_options.getOption('showFps')
    fpsLabel:setVisible(show)
    if show then fpsLabel:setText('FPS: ' .. fps) end
end

local function onPingBack(ping)
    if not pingLabel then return end
    local show = modules.client_options.getOption('showPing')
    pingLabel:setVisible(show)
    if not show then return end
    if ping < 0 then
        pingLabel:setText('Ping: ??')
        pingLabel:setColor('#ffff00')
    else
        pingLabel:setText('Ping: ' .. ping .. ' ms')
        pingLabel:setColor(ping >= 500 and '#ff3030' or (ping >= 250 and '#ffff00' or '#00ff00'))
    end
end

-- Dentro do jogo --------------------------------------------------------------
-- Barras de acao laterais vazias ficam com 1 px de largura e a borda delas
-- (escura a esquerda, clara a direita) aparecia colada na moldura do mapa,
-- parecendo duas molduras em conflito. Sem barra, sem borda.
local function fixActionPanelBorders()
    local gi = modules.game_interface
    if not gi or not gi.getLeftActionPanel then return end
    local function apply(panel, side)
        if not panel or panel:isDestroyed() then return end
        local empty = panel:getWidth() <= 2
        -- vazia: nao desenha nada por cima da moldura do mapa (fundo nem borda)
        panel:setOpacity(empty and 0 or 1)
        if side == 'left' then
            panel:setBorderWidthRight(empty and 0 or 1)
        else
            panel:setBorderWidthLeft(empty and 0 or 1)
        end
    end
    for side, panel in pairs({ left = gi.getLeftActionPanel(), right = gi.getRightActionPanel() }) do
        if panel and not panel.__classic74Border then
            panel.__classic74Border = true
            connect(panel, { onGeometryChange = function() apply(panel, side) end })
        end
        apply(panel, side)
    end
end

local function stripGameScreen()
    fixActionPanelBorders()
    setupMinimap()
    setupPanelButtons()
    setupConsole()
    setupFpsPing()
    local topMenu = getTopMenu()
    if topMenu then topMenu:setVisible(false) end
    -- 7.4 não tinha soul points
    hideWidget(rootWidget, 'soulPanel')
    local skills = rootWidget:recursiveGetChildById('skillWindow')
    local skillSoul = skills and skills:recursiveGetChildById('soul')
    if skillSoul then skillSoul:hide() end
    local soulCap = rootWidget:recursiveGetChildById('soulAndCapacity')
    if soulCap then
        for _, child in ipairs(soulCap:getChildren()) do
            if child:getId() == 'soul' or child:getText() == tr('Soul') then child:setVisible(false) end
        end
    end
end

local function onGameStart()
    -- entrou no jogo (login, reconexão ou cam): nenhuma janela da tela de login fica por cima
    if EnterGame and EnterGame.hide then EnterGame.hide() end
    if camWindow then camWindow:destroy(); camWindow = nil end
    if favoriteAddWindow then favoriteAddWindow:destroy(); favoriteAddWindow = nil end
    if favoritesWindow then favoritesWindow:destroy(); favoritesWindow = nil end
    scheduleEvent(stripGameScreen, 100)
end

local function onRootGeometryChange()
    scheduleEvent(fitBackground, 1)
end

local function onGameEnd()
    scheduleEvent(function()
        setupLoginScreen()
        -- fim de uma cam: volta para o Enter Game. Numa queda de conexão quem
        -- decide é a lista de personagens/reconexão do próprio cliente.
        if playingCam then
            playingCam = false
            showEnterGameIfIdle()
        end
    end, 300)
end

function init()
    applyFirstRunDefaults()
    connect(rootWidget, { onGeometryChange = onRootGeometryChange })
    connect(g_game, {
        onGameStart = onGameStart,
        onGameEnd = onGameEnd,
        onPingBack = onPingBack
    })
    connect(g_app, { onFps = onFps })
    Keybind.new('Misc.', 'Favorite Accounts', 'Ctrl+F', '')
    Keybind.bind('Misc.', 'Favorite Accounts', {
        { type = KEY_DOWN, callback = function() if not g_game.isOnline() then toggleFavorites() end end }
    })
    -- 7.4 sem som: tira o atalho de mudo (religaria o audio) da lista de atalhos
    scheduleEvent(function() Keybind.delete('Sound', 'Mute/unmute') end, 100)
    scheduleEvent(setupLoginScreen, 250)
end

function terminate()
    disconnect(g_app, { onFps = onFps })
    disconnect(rootWidget, { onGeometryChange = onRootGeometryChange })
    disconnect(g_game, { onGameStart = onGameStart, onGameEnd = onGameEnd, onPingBack = onPingBack })
    Keybind.delete('Misc.', 'Favorite Accounts')
    if camWindow then camWindow:destroy(); camWindow = nil end
    if favoriteAddWindow then favoriteAddWindow:destroy(); favoriteAddWindow = nil end
    if favoritesWindow then favoritesWindow:destroy(); favoritesWindow = nil end
    for _, w in ipairs({ panelButtonsWindow, bottomButtonsWindow, fpsLabel, pingLabel, asdwBox }) do
        if w and not w:isDestroyed() then w:destroy() end
    end
    panelButtonsWindow, bottomButtonsWindow, fpsLabel, pingLabel, asdwBox = nil, nil, nil, nil, nil
    local console = modules.game_console
    if console and console.__classic74 then
        console.toggleChat = console.__classic74Toggle
        console.__classic74, console.__classic74Toggle = nil, nil
    end
end
