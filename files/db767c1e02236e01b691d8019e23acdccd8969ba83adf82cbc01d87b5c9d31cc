local function applyFirstRunDefaults()
    local version = g_settings.getNumber('classic74_defaults')
    if version >= DEFAULTS_VERSION then
        return
    end
    if version < 1 then
        for key, value in pairs(defaults) do
            g_settings.set(key, value)
        end
    end
    for v = math.max(version + 1, 2), DEFAULTS_VERSION do
        for key, value in pairs(defaultsByVersion[v] or {}) do
            g_settings.set(key, value)
        end
    end
    g_settings.set('classic74_defaults', DEFAULTS_VERSION)
    g_settings.save()
end

local function hideWidget(root, id)
    if not root then return end
    local w = root:recursiveGetChildById(id)
    if w then
        w:setVisible(false)
        if w.setWidth then w:setWidth(0) end
    end
end

