--- Enables or disables the entire server configuration block.
-- Set to `false` to disable all configuration below.
local ENABLE_SERVERS = true

---
-- @module Servers_init
-- Configuration table for all servers used by the system.
--
-- This entire block is conditionally enabled based on ENABLE_SERVERS.
-- When ENABLE_SERVERS == false, everything is ignored/disabled.
--

---
-- Server configuration system for multi-server or multi-world clients.
--
-- This structure allows a single client build to connect to multiple servers
-- without requiring duplicate client folders.
--
-- A server that hosts several worlds, or that provides a separate test environment,
-- can simply define additional entries inside this configuration table.
--
-- Instead of maintaining multiple client installations (one per world/server),
-- the client can switch between servers by selecting the desired configuration entry.
-- This simplifies testing, avoids redundant directories, and centralizes connection settings.
--
-- The ENABLE_SERVERS flag allows the entire configuration block to be enabled or disabled
-- without deleting or commenting out individual entries.
--

Servers_init = {}

if ENABLE_SERVERS then

    ---
    -- List of servers and their configuration parameters.
    -- Each entry defines port, protocol, and authentication options.
    -- @table Servers_init
    --
    Servers_init = {
        -- OTServ 7.4: servidor de TESTE no PC do dono pelo Tailscale (so com
        -- usar-pc.txt; o oficial entra pelo proxy, ver abaixo).
        ["100.110.112.125"] = {
            port = 7171,
            protocol = 740,
            httpLogin = false
        }
    }
end

-- OTServ 7.4 (Telmora): proxies anti-DDoS, como no Miracle (plano nos docs do
-- Projeto claude/hospedagem-proxies.md e claude/migracao-vps.md). O cliente fica
-- ligado a todos, manda tudo pelos 2 de menor ping e troca sozinho quando um
-- cai; o IP do servidor nunca aparece. priority soma ao ping na escolha (maior =
-- so usa se os outros cairem). Os nomes ficam no DNS (Cloudflare, nuvem cinza):
-- trocar o IP de um proxy nao precisa de build nova.
PROXIES = {
    { host = "br1.playtelmora.com", port = 7201, priority = 0 }, -- Sao Paulo
}

-- Alpha (15/11): o servidor oficial roda na VPS da MagnoHost (Sao Paulo), atras
-- do proxy; o PC do dono virou ambiente de teste. Por padrao tudo vai pelo
-- proxy. Quem cria um arquivo vazio "usar-pc.txt" na pasta do cliente entra no
-- servidor de teste do PC pelo Tailscale (so a staff/dev). O arquivo fica fora
-- do manifesto da prova de integridade (so init.lua, config.ini, data/,
-- modules/, mods/ e classic74/ contam).
local USAR_PC = g_platform.fileExists(g_resources.getWorkDir() .. 'usar-pc.txt')
local USAR_PROXY = not USAR_PC

if USAR_PROXY and #PROXIES > 0 then
    for _, p in ipairs(PROXIES) do
        g_proxy.addProxy(p.host, p.port, p.priority or 0)
    end
    g_proxy.setMaxActiveProxies(2)
    -- login pelo proxy; o servidor responde a lista de personagens com
    -- 127.0.0.1, que o cliente tambem entrega ao proxy
    Servers_init = {
        ["proxy"] = {
            port = 7171,
            protocol = 740,
            httpLogin = false
        }
    }
end

