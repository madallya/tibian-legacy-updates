    id: pulse
    anchors.top: itemSlot.top
    anchors.left: itemSlot.left
    margin-top: -5
    margin-left: -5
    size: 76 76
    visible: false
    phantom: true

  // a borda dourada da tentativa (forge74.lua, playForge): acende embaixo, sobe pelos 2 lados
  // e fecha no meio do topo; 2 px, 3 px para fora do slot
  Forge74Fx
    id: fxBottom
    anchors.bottom: itemSlot.bottom
    anchors.horizontalCenter: itemSlot.horizontalCenter
    margin-bottom: -3
    size: 0 2

  Forge74Fx
    id: fxLeft
    anchors.bottom: itemSlot.bottom
    anchors.left: itemSlot.left
    margin-bottom: -3
    margin-left: -3
    size: 2 0

  Forge74Fx
    id: fxRight
    anchors.bottom: itemSlot.bottom
    anchors.right: itemSlot.right
    margin-bottom: -3
    margin-right: -3
    size: 2 0

  Forge74Fx
    id: fxTopL
    anchors.top: itemSlot.top
    anchors.left: itemSlot.left
    margin-top: -3
    margin-left: -3
    size: 0 2

  Forge74Fx
    id: fxTopR
    anchors.top: itemSlot.top
    anchors.right: itemSlot.right
    margin-top: -3
    margin-right: -3
    size: 0 2

  // 27/11 (dono): a barra do Smelt (cada barra leva 1,5 s; o Smelt all repete)
  UIWidget
    id: channelBar
    anchors.top: itemSlot.top
    anchors.left: itemSlot.right
    anchors.right: parent.right
    margin-top: 3
    margin-left: 8
    height: 9
    background-color: #00000066
    border-width: 1
    border-color: #5c5c5c
    visible: false
    phantom: true

    UIWidget
      id: channelFill
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin: 1
      width: 0
      background-color: #c8a03c
      phantom: true

  Label
    id: itemName
    anchors.left: itemSlot.right
    anchors.right: parent.right
    anchors.top: itemSlot.top
    margin-left: 8
    margin-top: 15
    height: 16
    font: verdana-11px-antialised
    color: #dfdfdf
    text-align: center
    phantom: true

  // 27/11 (dono): a ficha do item (Atk/Def/Arm, peso e descricao), como no Look
  Label
    id: itemDesc
    anchors.left: itemName.left
    anchors.right: parent.right
    anchors.top: itemName.bottom
    anchors.bottom: itemSlot.bottom
    margin-top: 1
    font: verdana-11px-antialised
    color: #b0b0b0
    text-align: center
    text-wrap: true
    phantom: true

  UIWidget
    id: attrList
    anchors.top: itemSlot.bottom
    anchors.left: itemSlot.left
    anchors.right: parent.right
    margin-top: 6
    height: 78
    layout:
      type: verticalBox
      spacing: 0

  HorizontalSeparator
    id: sepSigil
    anchors.top: attrList.bottom
    anchors.left: itemSlot.left
    anchors.right: parent.right
    margin-top: 2

  // ---------------------------------------------- Attune: o Sigil do slot e a proxima tentativa
  UIWidget
    id: attunePanel
    anchors.top: sepSigil.bottom
    anchors.left: itemSlot.left
    anchors.right: parent.right
    anchors.bottom: footSep2.top
    phantom: true

    Forge74Slot
      id: sigilSlot
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 6

    Forge74Text
      id: sigilName
      anchors.top: sigilSlot.top
      anchors.left: sigilSlot.right
      margin-left: 8
      margin-top: 2

    Forge74Text
      id: sigilCount
      anchors.top: sigilName.top
      anchors.right: parent.right

    Forge74Muted
      id: sigilCracked
      anchors.top: sigilName.bottom
      anchors.left: sigilName.left
      margin-top: 3

    Forge74Text
      id: nextLabel
      anchors.top: sigilSlot.bottom
      anchors.left: parent.left
      margin-top: 6

    Forge74Text
      id: nextChance
      anchors.top: nextLabel.top
      anchors.right: parent.right

    Forge74Text
      id: feeLabel
      anchors.top: nextLabel.bottom
      anchors.left: parent.left
      margin-top: 1
      !text: tr('Fee')

    Forge74Text
      id: feeValue
      anchors.top: feeLabel.top
      anchors.right: parent.right

    Forge74Muted
      id: goldLabel
      anchors.top: feeLabel.bottom
      anchors.left: parent.left
      margin-top: 1
      !text: tr('Your gold')

    Forge74Muted
      id: goldValue
      anchors.top: goldLabel.top
      anchors.right: parent.right

  // ---------------------------------------------- Forge, Smelt e Repair: os materiais
  UIWidget
    id: recipePanel
    anchors.top: sepSigil.bottom
    anchors.left: itemSlot.left
    anchors.right: parent.right
    anchors.bottom: footSep2.top
    visible: false
    phantom: true

    UIWidget
      id: matList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 108
      phantom: true
      layout:
        type: verticalBox
        spacing: 0

    Forge74Text
      id: rChanceLabel
      anchors.top: matList.bottom
      anchors.left: parent.left
      margin-top: 4
      !text: tr('Chance')

    Forge74Text
      id: rChance
      anchors.top: rChanceLabel.top
      anchors.right: parent.right

    Forge74Text
      id: rFeeLabel
      anchors.top: rChanceLabel.bottom
      anchors.left: parent.left
      margin-top: 1
      !text: tr('Fee')

    Forge74Text
      id: rFee
      anchors.top: rFeeLabel.top
      anchors.right: parent.right

    Forge74Muted
      id: rGoldLabel
      anchors.top: rFeeLabel.bottom
      anchors.left: parent.left
      margin-top: 1
      !text: tr('Your gold')

    Forge74Muted
      id: rGold
      anchors.top: rGoldLabel.top
      anchors.right: parent.right

    // 27/11 (dono): o primal catalyst e um botao com o desenho dele (apertado = usa)
    UIWidget
      id: catalystRow
      anchors.top: rGoldLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 36
      phantom: true

      Item
        id: catalystButton
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34
        padding: 1
        image-source: /images/ui/item
        virtual: true
        focusable: false
        phantom: false
