// Forge Anvil (comando 0xF8, servidor src/game/sigils.hh). Layout padrao Miracle do
// rascunho claude/sigils-tela-forja-rascunho.md, so com pecas do cliente (decisao do dono,
// 26/11: janela SEM bigorna). O unico efeito e o pulso de cor no slot do item (MORPH:
// 12 quadros de 38 x 38 a 83 ms; vermelho na falha) com a borda dourada da tentativa.
// Fase 2 (27/11, doc claude/profissoes-telmora.md v4, secao 12): abas Attune, Forge, Smelt,
// Repair, Services e Salvage, no estilo das abas da Cyclopedia (Miracle). Attune, Services
// e Salvage para qualquer jogador; Forge, Smelt e Repair so para o ferreiro. Sem a fase 2
// no servidor (sem o sub 4) a linha de abas some e a janela fica como na fase 1.
// O icone de cada aba e o desenho de um item ate o MORPH entregar os icones 34 x 34.

Forge74Text < Label
  font: verdana-11px-antialised
  color: #dfdfdf
  text-auto-resize: true
  phantom: true

Forge74Muted < Forge74Text
  color: #c0c0c0

// casa 34 x 34 (item.png) com o item 32 x 32 dentro; a moldura de atributo troca a imagem
Forge74Slot < Item
  size: 34 34
  padding: 1
  image-source: /images/ui/item
  virtual: true
  focusable: false

// 27/11 (dono): o slot grande com o fundo do item66 (66 x 66, sem esticar) e a moldura de atributo
// por cima, so a borda (attr_frames com image-border): sem as listras do slot esticado
Forge74BigSlot < Item
  size: 66 66
  padding: 1
  image-source: /images/ui/item66
  virtual: true
  focusable: false

  UIWidget
    id: bigFrame
    anchors.fill: parent
    image-border: 7
    phantom: true

// um traco da borda dourada da tentativa (cor e tamanho pelo forge74.lua)
Forge74Fx < UIWidget
  background-color: #f2c94c
  visible: false
  phantom: true
  focusable: false

Forge74ListSlot < Forge74Slot
  phantom: false

  // borda clara do item escolhido (por cima da moldura de atributo), como na Cyclopedia
  UIWidget
    id: selection
    anchors.fill: parent
    border-width: 1
    border-color: #dfdfdf
    visible: false
    phantom: true

// 27/11 (dono): a lista do Smelt em linhas (desenho e nome da barra)
Forge74ListRow < UIWidget
  height: 38
  focusable: false
  background-color: alpha

  Forge74Slot
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    phantom: true

  Label
    id: name
    anchors.left: slot.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised
    color: #dfdfdf
    text-wrap: true
    height: 28
    phantom: true

  UIWidget
    id: selection
    anchors.fill: parent
    border-width: 1
    border-color: #dfdfdf
    visible: false
    phantom: true

// moldura das secoes (Services): borda de 1 px em relevo, fundo um pouco mais escuro
Forge74Box < UIWidget
  background-color: #00000030
  border-width: 1
  border-color-top: #262626
  border-color-left: #232323
  border-color-bottom: #5c5c5c
  border-color-right: #5c5c5c
  phantom: true

// aba no estilo da Cyclopedia (Miracle): moldura de 1 px em relevo; a ativa afundada
Forge74Tab < UIButton
  height: 36
  width: 103
  anchors.top: parent.top
  anchors.left: prev.right
  margin-left: -1
  text-align: left
  text-offset: 41 0
  font: verdana-11px-monochrome
  color: #dfdfdf
  background-color: #00000026
  border-width: 1
  border-color-top: #6c6c6c
  border-color-left: #626262
  border-color-bottom: #262626
  border-color-right: #232323
  $checked:
    margin-top: 1
    height: 35
    border-color-top: #262626
    border-color-left: #232323
    border-color-bottom: #656565
    border-color-right: #666666
  $disabled:
    color: #dfdfdf66

  UIItem
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    size: 32 32
    virtual: true
    phantom: true

  // desenho da aba (MORPH, 27/11): images/aba_<aba>.png 32x32, no lugar do item
  UIWidget
    id: art
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    size: 32 32
    phantom: true

// uma linha de material: a casa com o item, o nome e quanto tem / precisa
Forge74MatRow < UIWidget
  height: 36
  phantom: true

  Forge74Slot
    id: slot
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter

  Forge74Text
    id: name
    anchors.left: slot.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8

  Forge74Text
    id: have
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

// uma linha de atributo do Services (clicar escolhe o atributo da Sigil Soul)
Forge74AttrRow < UIWidget
  height: 15
  focusable: false
  background-color: alpha

  // 27/11 (dono): o circulo marca o atributo escolhido
  UIWidget
    id: radio
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 12 12
    image-source: /images/ui/checkboxcircle
    image-clip: 0 0 12 12
    phantom: true

  Label
    id: text
    anchors.left: radio.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    font: verdana-11px-antialised
    color: #c7c7c7
    text-auto-resize: true
    phantom: true

MainWindow
  id: forge74Window
  !text: tr('Forge Anvil')
  size: 660 478
  visible: false
  @onEscape: modules.game_forge74.closeByPlayer()

  // ---------------------------------------------- as abas (so com a fase 2 no servidor)
  UIWidget
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    height: 36

    Forge74Tab
      id: tabAttune
      anchors.left: parent.left
      margin-left: 0
      !text: tr('Attune')
      @onClick: modules.game_forge74.showTab('attune')

    Forge74Tab
      id: tabForge
      !text: tr('Forge')
      @onClick: modules.game_forge74.showTab('forge')

    Forge74Tab
      id: tabSmelt
      !text: tr('Smelt')
      @onClick: modules.game_forge74.showTab('smelt')

    Forge74Tab
      id: tabRepair
      !text: tr('Repair')
      @onClick: modules.game_forge74.showTab('repair')

    Forge74Tab
      id: tabServices
      !text: tr('Services')
      @onClick: modules.game_forge74.showTab('services')

    Forge74Tab
      id: tabSalvage
      !text: tr('Salvage')
      @onClick: modules.game_forge74.showTab('salvage')

    UIWidget
      id: tabBarRest
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: tabSalvage.right
      anchors.right: parent.right
      background-color: #00000035
      phantom: true

  // ---------------------------------------------- esquerda: a lista da aba
  ScrollablePanel
    id: itemsPanel
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    margin-top: 6
    size: 200 326
    image-source: /images/ui/panel_flat
    image-border: 1
    padding: 5
    vertical-scrollbar: itemsScroll
    layout:
      type: grid
      cell-size: 34 34
      cell-spacing: 5
      num-columns: 5
      flow: true

  // 27/11 (dono): no Forge, no Smelt e no Repair a lista e em linhas (receitas fixas: desenho e nome)
  ScrollablePanel
    id: rowsPanel
    anchors.top: itemsPanel.top
    anchors.left: itemsPanel.left
    anchors.right: itemsPanel.right
    anchors.bottom: itemsPanel.bottom
    padding: 5
    image-source: /images/ui/panel_flat
    image-border: 1
    vertical-scrollbar: rowsScroll
    visible: false
    layout:
      type: verticalBox
      spacing: 3

  VerticalScrollBar
    id: rowsScroll
    anchors.top: itemsPanel.top
    anchors.bottom: itemsPanel.bottom
    anchors.left: itemsPanel.right
    step: 41
    pixels-scroll: true
    visible: false

  // 27/11 (dono): no Salvage, sem lista: o slot fica no meio desta caixa e o jogador arrasta o item
  UIWidget
    id: salvageBox
    anchors.top: itemsPanel.top
    anchors.left: itemsPanel.left
    anchors.right: itemsScroll.right
    anchors.bottom: itemsPanel.bottom
    image-source: /images/ui/panel_flat
    image-border: 1
    visible: false

  Forge74BigSlot
    id: salSlot
    anchors.centerIn: salvageBox
    visible: false

  Label
    id: salDrop
    anchors.top: salvageBox.verticalCenter
    anchors.left: salvageBox.left
    anchors.right: salvageBox.right
    margin-top: 42
    font: verdana-11px-antialised
    color: #c0c0c0
    text-align: center
    text-wrap: true
    height: 30
    visible: false
    phantom: true
    !text: tr('Drag an item here.')

  VerticalScrollBar
    id: itemsScroll
    anchors.top: itemsPanel.top
    anchors.bottom: itemsPanel.bottom
    anchors.left: itemsPanel.right
    step: 39
    pixels-scroll: true

  Forge74Muted
    id: itemsLabel
    anchors.top: itemsPanel.bottom
    anchors.left: itemsPanel.left
    margin-top: 4
    !text: tr('Equipment you carry')

  // nao-ferreiro nas abas Forge, Smelt e Repair
  Label
    id: memberHint
    anchors.top: itemsPanel.top
    anchors.left: itemsScroll.right
    anchors.right: parent.right
    margin-top: 110
    margin-left: 15
    font: verdana-11px-antialised
    color: #c0c0c0
    text-align: center
    text-wrap: true
    text-auto-resize: true
    visible: false
    phantom: true

  // ---------------------------------------------- direita, em cima: o item escolhido
  // 26/11 (dono): o item em destaque, num slot maior (70 x 70: o desenho em 2x), com o nome
  // centralizado ao lado e os atributos embaixo. A borda dourada da tentativa corre em volta.
  Forge74BigSlot
    id: itemSlot
    anchors.top: itemsPanel.top
    anchors.left: itemsScroll.right
    margin-top: 5
    margin-left: 15

  // o pulso de cor do MORPH, em 2x (38 x 38 -> 76 x 76, 3 px para fora do slot)
