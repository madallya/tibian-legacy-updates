          text-auto-resize: true
          phantom: true

      Label
        id: catalystText
        anchors.left: catalystButton.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        font: verdana-11px-antialised
        color: #c0c0c0
        text-wrap: true
        height: 28
        phantom: true

  // ---------------------------------------------- Services: Void Sigil e Sigil Soul
  // 27/11 (dono): cada um numa moldura, com o seu botao embaixo
  UIWidget
    id: servicesPanel
    anchors.top: sepSigil.bottom
    anchors.left: itemSlot.left
    anchors.right: parent.right
    anchors.bottom: footSep2.top
    visible: false
    phantom: true

    Forge74Box
      id: voidBox
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 80

      Forge74MatRow
