BattleFilter74 < UIButton
  size: 20 20
  image-source: /images/game/battle/filters74
  checkable: true
  @onCheckChange: |
    local x = self.clipX or 0
    self:setImageClip({ x = x, y = self:isChecked() and 20 or 0, width = 20, height = 20 })

