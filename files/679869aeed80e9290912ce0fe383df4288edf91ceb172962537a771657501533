BattleIcon < UIButton
  size: 20 20
  image-source: /images/options/button_empty
  image-clip: 0 0 20 20
  image-border: 3
  checkable: true

  $pressed:
    image-clip: 20 0 20 20

  $on:
    image-clip: 20 0 20 20

  $checked:
    image-clip: 20 0 20 20

  $active:
    image-clip: 20 0 20 20

  $hover !disabled:
    image-color: #ffffffcc

  $disabled:
    image-color: #ffffff88

  UIWidget
    id: iconWidget
    anchors.centerIn: parent
    image-color: white
    focusable: false
    phantom: true

