MiniWindow
  id: battleWindow
  height: 166
  image-smooth: false
  @onOpen: onOpen()
  @onClose: onClose()
  &save: true
   
  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    image-source: /images/game/battle/icon-battlelist
    image-rect: 0 0 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    color: #ffffffe7
    !text: tr('Battle List')

  // 7.4 (Miracle): 5 filtros (jogador, NPC, monstro, sem caveira, grupo);
  // apertado = escondendo, botao afundado e mais escuro
  Panel
    id: filterPanel
    margin-top: 21
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-right: 15
    height: 20
    width: 120
    layout:
      type: horizontalBox
      spacing: 5

    BattleFilter74
      id: hidePlayers
      image-clip: 0 0 20 20
      &clipX: 0
      !tooltip: tr('Hide players')
      @onClick: modules.game_battle.onFilterButtonClick(self)

    BattleFilter74
      id: hideNPCs
      image-clip: 20 0 20 20
      &clipX: 20
      !tooltip: tr('Hide NPCs')
      @onClick: modules.game_battle.onFilterButtonClick(self)

    BattleFilter74
      id: hideMonsters
      image-clip: 40 0 20 20
      &clipX: 40
      !tooltip: tr('Hide monsters')
      @onClick: modules.game_battle.onFilterButtonClick(self)

    BattleFilter74
      id: hideSkulls
      image-clip: 60 0 20 20
      &clipX: 60
      !tooltip: tr('Hide non-skull players')
      @onClick: modules.game_battle.onFilterButtonClick(self)

    BattleFilter74
      id: hideParty
      image-clip: 80 0 20 20
      &clipX: 80
      !tooltip: tr('Hide party members')
      @onClick: modules.game_battle.onFilterButtonClick(self)

  // 7.4 (Miracle): ordem da lista logo abaixo dos filtros
  Panel
    id: sortPanel
    height: 22
    anchors.top: filterPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 8
    margin-right: 22

    BattleCombo74
      id: sortType
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      height: 22
      margin-right: -22
      !tooltip: tr('Sort by')

    BattleCombo74
      id: sortOrder
      anchors.top: parent.top
      anchors.left: prev.right
      anchors.right: parent.right
      height: 22
      margin-left: 3
      !tooltip: tr('Sort order')

  // linha que separa filtros e lista (escuro + claro) com a setinha do Miracle
  // que esconde/mostra os filtros
  HorizontalSeparator
    id: HorizontalSeparator
    anchors.top: sortPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 3
    margin-right: 18
    margin-top: 12
    height: 2

  UIButton
    id: filterToggle74
    size: 21 11
    anchors.bottom: HorizontalSeparator.top
    anchors.horizontalCenter: HorizontalSeparator.horizontalCenter
    image-source: /images/game/battle/filtertoggle74
    image-clip: 0 0 21 11
    !tooltip: tr('Hide filters')

  MiniWindowContents
    id: contentsPanel
    anchors.top: HorizontalSeparator.bottom
    margin-top: 4

    Panel
      id: battlePanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 5
      padding-right: 5
      layout:
        type: verticalBox
        fit-children: true

    UIWidget
      id: resizeIndicator
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 0
      margin-left: 0
      image-source: /images/ui/miniborder
      image-smooth: false
      focusable: false
      margin-bottom: 0
      margin-left: 0
      image-source: /images/ui/miniborder
      image-smooth: false
      focusable: false
    margin-bottom: 3
    pixels-scroll: true
    $!on:
      width: 0

